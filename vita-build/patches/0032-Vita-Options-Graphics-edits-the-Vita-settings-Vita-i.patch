+#ifdef __vita__
+/* the Vita: one screen (no window rows, VSync or antialiasing), no shadows on OpenGL ES, one
+   version's files; its own rows instead */
+static int RowShown(int i) {
+	switch (i) {
+		case GFX_MODE:
+		case GFX_RESOLUTION:
+		case GFX_WIDESCREEN:
+		case GFX_SHADOWS:
+		case GFX_ANTIALIASING:
+		case GFX_VSYNC:
+		case GFX_DATA:
+			return 0;
+		default:
+			return 1;
+	}
