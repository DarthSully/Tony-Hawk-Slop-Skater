 /* Settings.ini in the player's folder (Runtime::UserDir): one file, a section per subsystem. The
- * controls (pc_input.cpp) and the display ([Video], pc_video.cpp) each read their own sections
- * and write them back; this class owns the file itself. The C interface is pc_settings.h. */
+ * controls (pc_input.cpp), the display ([Video], pc_video.cpp) and the Vita's graphics ([Vita],
+ * pc_vitagfx.cpp) each read their own sections and write them back; this class owns the file
+ * itself. The C interface is pc_settings.h. */
 #pragma once
 
+#include <stdio.h>
+
 #include "pc/platform.h"
 
 namespace pc {
@@ -24,4 +27,12 @@ private:
 
 extern Settings g_settings;
 
+/* Settings.ini's [Vita] section (src/pc_vitagfx.cpp, pc_vitagfx.h): the defaults, an entry (1 if
