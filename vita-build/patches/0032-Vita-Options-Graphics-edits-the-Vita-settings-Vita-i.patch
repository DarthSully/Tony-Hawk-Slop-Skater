+ * defaults and the environment matter; the section is written on the Vita only). */
+#ifndef PC_VITAGFX_H
+#define PC_VITAGFX_H
 
 typedef struct PC_VitaGfx {
-    int render_w, render_h; /* the screens drawn at most this size: 512x240, 720x408, 960x544 */
-    int widescreen;         /* 16:9 gameplay (native 3D only) */
-    int smoothing;          /* gameplay scaled up smoothly */
-    int frame_rate;         /* 60, or 30: every other frame shown */
-    int native3d;           /* the native 3D renderer, else the PS1 path */
+    int render_w, render_h; /* 3D/screen render size: 512x240, 720x408 or 960x544 (default 960x544) */
+    int widescreen;         /* 1 = 16:9 3D (default 1) */
+    int smoothing;          /* 1 = bilinear upscale of the picture (default 1) */
+    int frame_rate;         /* 60 or 30 (locked 30) (default 60) */
+    int native3d;           /* 1 = Native 3D renderer, 0 = PlayStation (PS1) path (default 1) */
+    int pgxp;               /* 1 = sub-pixel vertices and perspective-correct textures (default 1) */
 } PC_VitaGfx;
 
 #ifdef __cplusplus
 extern "C" {
 #endif
-/* The settings for this run (read once): THPS_VITA_RES=WxH, THPS_WIDESCREEN=0|1, THPS_FILTER=0|1,
