+/* the Vita's render size one step on */
+static void StepVitaRes(PC_VitaGfx *g, int d) {
+	int i, w, h, at = PC_VITAGFX_SIZES - 1;
+
+	for (i = 0; i < PC_VITAGFX_SIZES; i++) {
