+/* the texture cache's key for a textured triangle (CacheSlot.key), from its first vertex; 0 for
+ * an untextured one or an HD texture (which has its own) */
+uint64_t SlotKey(const GVert &v)
+{
+    uint16_t info = v.info;
+    uint32_t depth = (info >> 7) & 3;
+    if (!(info & I_TEXTURED) || depth == 3)
+        return 0;
+    uint32_t clut = depth == 2 ? 0 : (uint32_t)(v.clut & 0x7fff);
+    uint32_t win = (uint32_t)v.tw[0] | (uint32_t)v.tw[1] << 8 | (uint32_t)v.tw[2] << 16 |
+                   (uint32_t)v.tw[3] << 24;
+    return (1u | depth << 1 | (uint32_t)(info & 15) << 3 | (uint32_t)((info >> 4) & 1) << 7 |
+            clut << 8) | (uint64_t)win << 32;
+}
