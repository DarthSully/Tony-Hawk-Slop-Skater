+ * The boot self-test (THPS_GL_SELFTEST=0 skips it). Known texels go through every way a draw
+ * reads a texture and the base target's pixels are read back, so the log shows what the GPU
+ * returned rather than what should be there. A test row is 256 pixels showing texels 0..255 of a
+ * 16-bit test page, each texel's colour spelling its u and page row, then a flat white pixel: the
+ * read-back's own reference. A path that isn't exact is fixed or dropped before the game draws:
+ * the texture cache tries its other atlas shape, then the shift it measured in the descriptor's
+ * address, then in the shader, else turns off; the store's own copies give way to vitaGL's
+ * texture; the blit and movie-picture pools to vitaGL's copies. (t12 and t13's menus: every cached
+ * texel came from 6 to its left, though the slots held the right texels where the descriptor
+ * pointed.) */
+
+namespace {
+constexpr int kTestPageX = 768, kTestPageY = 256;   /* a 16-bit page: its rows 0..3 hold the test */
+constexpr int kTestY = 496;                          /* VRAM rows 496..511: unused at boot, cleared */
+
+/* test texel u of page row r, 15 bits: R u & 31, G u >> 5 | r << 3, B 21 (never 0: opaque) */
+uint16_t TestTexel(int u, int r)
+{
+    return (uint16_t)((u & 31) | ((u >> 5) | r << 3) << 5 | 21 << 10);
+}
+
+/* a raw 16-bit sprite of the test page (textured), or a flat one, over all of VRAM */
+void TestPrim(GlPrim *p, int textured)
+{
+    *p = GlPrim{};
+    p->textured = textured;
+    p->raw = textured;
+    p->depth = 2;
+    p->tp_x = kTestPageX;
+    p->tp_y = kTestPageY;
+    p->tw_and_x = p->tw_and_y = 0xff;
+    p->clip_r = GlGpu::VRAM_W - 1;
+    p->clip_b = GlGpu::VRAM_H - 1;
+}
+}   // namespace
+
+int GlGpu::TestExact(const TestResult &t)
+{
+    int off = t.ref < 0 ? -t.ref : t.ref;
+    return t.ref != -999 && t.shift == 0 && t.agree >= 256 - off;
+}
+
+const char *GlGpu::TestText(const TestResult &t, char *buf, int n)
+{
+    if (TestExact(t) && !t.ref)
+        snprintf(buf, n, "exact");
+    else if (t.ref == -999)
+        snprintf(buf, n, "no reference pixel (read-back or flat drawing wrong)");
+    else
+        snprintf(buf, n, "texels %+d (%d of 256 pixels), page rows %+d, read-back %+d", t.shift,
+                 t.agree, t.row, t.ref);
+    return buf;
+}
+
+/* VRAM row y blank (a test that draws nothing mustn't find the last one's pixels) */
+void GlGpu::TestClear(int y)
+{
+    Fill(0, y, 288, 1, 0);
+}
+
+/* the flat white reference pixel at 256, y, and everything drawn */
+void GlGpu::TestWhite(int y)
+{
+    GlPrim f;
+    TestPrim(&f, 0);
+    Rect(&f, 256, y, 1, 1, 255, 255, 255, 0, 0, 0, 0);
+    Flush();
+}
+
+/* test row r at VRAM row y as the game draws a 16-bit sprite: pixel x shows texel x */
+void GlGpu::TestSprite(int y, int r)
+{
+    GlPrim p;
+    TestPrim(&p, 1);
+    TestClear(y);
+    Rect(&p, 0, y, 256, 1, 128, 128, 128, 0, r, 0, 0);
+    TestWhite(y);
+}
+
+/* a texture's texels 0..255 (u 0..u1, v 0..v1) onto VRAM row y, pixels 0..255, by the present
+ * program, as a movie picture is shown */
+void GlGpu::TestPicture(GLuint tex, float u1, float v1, int y)
+{
+    TestClear(y);
+    m_base.Use();
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_BLEND);
+    glDisable(GL_DEPTH_TEST);
+    float x0 = -1.0f, x1 = 2.0f * 256 / m_base.pw - 1.0f;
+    float y0 = 2.0f * y / m_base.ph - 1.0f, y1 = 2.0f * (y + 1) / m_base.ph - 1.0f;
+    float q[16] = { x0, y0, 0, 0, x1, y0, u1, 0, x0, y1, 0, v1, x1, y1, u1, v1 };
+    glUseProgram(m_presentProg);
+    glUniform1f(m_presentUAlpha, 1.0f);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    QuadAttribs(q, 4, 1);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+}
+
+/* how VRAM row y came out after test row r was drawn there */
+GlGpu::TestResult GlGpu::TestRow(int y, int r)
+{
+    TestResult res = { 0, 0, 0, -999 };
+    uint16_t px[288];
+    Read(0, y, 288, 1, px);
+    for (int k = 224; k < 288; k++)
+        if ((px[k] & 0x7fff) == 0x7fff) {
+            res.ref = k - 256;
+            break;
+        }
+    int off = res.ref == -999 ? 0 : res.ref, shifts[64] = {}, rows[8] = {};
+    for (int k = 0; k < 256; k++) {
+        int q = px[k] & 0x7fff, g = (q >> 5) & 31;
+        if (((q >> 10) & 31) != 21)
+            continue;
+        rows[(g >> 3) - r + 4]++;
+        if ((g >> 3) != r)
+            continue;
+        int d = ((q & 31) | (g & 7) << 5) - (k - off);
+        if (d >= -32 && d < 32)
+            shifts[d + 32]++;
+    }
+    for (int d = 0; d < 64; d++)
+        if (shifts[d] > res.agree) {
+            res.agree = shifts[d];
+            res.shift = d - 32;
+        }
+    for (int d = 0, most = 0; d < 8; d++)
+        if (rows[d] > most) {
+            most = rows[d];
+            res.row = d - 4;
+        }
+    return res;
+}
+
+/* the texture cache's slot s holding the test page (decoded as a miss would be), drawn at y */
+GlGpu::TestResult GlGpu::TestSlot(int s, int y, int r)
+{
+    GlPrim p;
+    GVert v;
+    TestPrim(&p, 1);
+    Put(&v, &p, PrimInfo(&p), 0, 0, 0, 0, 0, 0, 0);
+    memset(m_slot, 0, sizeof m_slot);
+    SlotFill(m_slot[s], SlotKey(v));
+    CacheDecode(s);
+    m_lastSlot = s;
+    TestSprite(y, r);
+    TestResult res = TestRow(y, r);
+    memset(m_slot, 0, sizeof m_slot);
+    m_lastSlot = -1;
+    return res;
+}
+
+/* the cache's rows at slots in the atlas's corners and middle, from VRAM row y (5 rows): all
+ * exact? The shift they all share (else 0) in *shift, a line for the log in out */
+int GlGpu::TestCache(int y, int *shift, char *out, int n)
+{
+    int c = m_atlasCols, last = kCacheSlots - 1;
+    int slots[5] = { 0, c - 1, (kCacheSlots / c / 2) * c + c / 2, last - c + 1, last };
+    int exact = 1, same = 1, at = snprintf(out, n, "%dx%d%s:", m_atlasW, m_atlasH,
+                                           m_atlasTex.bias ? " (address fix)" :
+                                           m_atlasFix[0] ? " (shader fix)" : "");
+    *shift = 0;
+    for (int i = 0; i < 5; i++) {
+        TestResult t = TestSlot(slots[i], y + i, i & 3);
+        int ok = TestExact(t);
+        exact &= ok;
+        if (i == 0)
+            *shift = t.shift;
+        else if (t.shift != *shift)
+            same = 0;
+        if (t.agree < 240)
+            same = 0;
+        if (at < n) {
+            if (ok)
+                at += snprintf(out + at, n - at, " slot %d ok", slots[i]);
+            else
+                at += snprintf(out + at, n - at, " slot %d %+d (%d/256, rows %+d, ref %+d)", slots[i],
+                               t.shift, t.agree, t.row, t.ref);
+        }
+    }
+    if (!same || exact)
+        *shift = 0;
+    return exact;
+}
+
+/* the cache's atlas made again as w x h (16x8 or 8x16 slots), empty; 0 without the memory */
+int GlGpu::AtlasLayout(int w, int h)
+{
+    glFinish();
+    glActiveTexture(GL_TEXTURE0 + kAtlasUnit);
+    FreeOwn(&m_atlasTex, 1);
+    int ok = OwnTexture(&m_atlasTex, GL_RGBA, 4, w, h);
+    glActiveTexture(GL_TEXTURE0);
+    m_atlas = m_atlasTex.tex;
+    m_atlasPtr = m_atlasTex.ptr;
+    m_atlasW = w;
+    m_atlasH = h;
+    m_atlasCols = w / 256;
+    m_atlasFix[0] = m_atlasFix[1] = 0;
+    memset(m_slot, 0, sizeof m_slot);
+    m_lastSlot = -1;
+    AtlasUniforms();
+    return ok;
+}
+
+/* the atlas's measured texel shift undone: in the descriptor's address, else in the shader;
+ * exact? (each try logged) */
+int GlGpu::CacheCorrect(int shift)
+{
+    char line[400];
+    int sh;
+    glFinish();
+    m_atlasTex.bias = -4 * shift;
+    if (sceGxmTextureSetData(m_atlasTex.gxm, m_atlasTex.ptr + m_atlasTex.bias) >= 0) {
+        int ok = TestCache(kTestY, &sh, line, sizeof line);
+        fprintf(stderr, "[gl] self-test: texture cache %s%s\n", line, ok ? ": using it" : "");
+        if (ok)
+            return 1;
+    }
+    glFinish();
+    m_atlasTex.bias = 0;
+    sceGxmTextureSetData(m_atlasTex.gxm, m_atlasTex.ptr);
+    m_atlasFix[0] = (float)-shift;
+    AtlasUniforms();
+    int ok = TestCache(kTestY, &sh, line, sizeof line);
+    fprintf(stderr, "[gl] self-test: texture cache %s%s\n", line, ok ? ": using it" : "");
+    if (ok)
+        return 1;
+    m_atlasFix[0] = 0;
+    AtlasUniforms();
+    return 0;
+}
+
+void GlGpu::SelfTest()
+{
+    char line[400], a[160], b[160];
+    uint16_t pat[4][256], zero[4][256] = {}, row[256];
+    for (int r = 0; r < 4; r++)
+        for (int u = 0; u < 256; u++)
+            pat[r][u] = TestTexel(u, r);
+    for (int i = 0; i < 32; i++)
+        m_to8[i] = (uint8_t)((i * 255 + 15) / 31);
+    g_textureStore.Upload(kTestPageX, kTestPageY, 256, 4, pat);
+
+    /* the emulated lookup (no cache): the store's texture */
+    int cache = m_cacheOn, ys = kTestY + 5;
+    m_cacheOn = 0;
+    TestSprite(ys, 1);
+    TestResult t = TestRow(ys, 1);
+    snprintf(line, sizeof line, "texture store (%s): %s", m_nstore ? "own copies" : "vitaGL's texture",
+             TestText(t, a, sizeof a));
+    if (!TestExact(t) && m_nstore) {
+        /* vitaGL's texture instead, as with THPS_GL_INPLACE=0 */
+        glFinish();
+        for (int i = 0; i < m_nstore; i++)
+            FreeOwn(&m_store[i], 1);
+        m_nstore = 0;
+        g_textureStore.Upload(kTestPageX, kTestPageY, 256, 4, pat);
+        TestSprite(ys, 1);
+        t = TestRow(ys, 1);
+        snprintf(line + strlen(line), sizeof line - strlen(line), " -> vitaGL's texture: %s",
+                 TestText(t, b, sizeof b));
+    }
+    m_cacheOn = cache;
+    fprintf(stderr, "[gl] self-test: %s\n", line);
+
+    /* the texture cache: this atlas shape, the other, then the shift they share undone */
+    if (m_cacheOn) {
+        int sh0, sh1 = 0, w0 = m_atlasW, h0 = m_atlasH;
+        int ok = TestCache(kTestY, &sh0, line, sizeof line);
+        fprintf(stderr, "[gl] self-test: texture cache %s%s\n", line, ok ? ": using it" : "");
+        if (!ok) {
+            ok = AtlasLayout(h0, w0);
+            if (ok) {
+                ok = TestCache(kTestY, &sh1, line, sizeof line);
+                fprintf(stderr, "[gl] self-test: texture cache %s%s\n", line, ok ? ": using it" : "");
+            }
+            if (!ok && sh1 && m_atlasPtr)
+                ok = CacheCorrect(sh1);
+            if (!ok && sh0 && AtlasLayout(w0, h0))
+                ok = CacheCorrect(sh0);
+        }
+        if (!ok) {
+            glFinish();
+            glActiveTexture(GL_TEXTURE0 + kAtlasUnit);
+            FreeOwn(&m_atlasTex, 1);
+            glActiveTexture(GL_TEXTURE0);
+            m_atlas = 0;
+            m_atlasPtr = nullptr;
+            m_cacheOn = 0;
+            fprintf(stderr, "[gl] self-test: texture cache off: no atlas shape or correction read "
+                            "exact (the emulated lookup draws everything, slower)\n");
+        }
+    }
+
+    /* blits: the CPU's pixels drawn by the copy program, from a pool texture */
+    int yb = kTestY + 6;
+    for (int u = 0; u < 256; u++)
+        row[u] = TestTexel(u, 2);
+    TestClear(yb);
+    Blit(0, yb, 256, 1, row);
+    TestWhite(yb);
+    t = TestRow(yb, 2);
+    snprintf(line, sizeof line, "blits (%s): %s", m_inPlace && m_poolBlits ? "pool" : "vitaGL's copy",
+             TestText(t, a, sizeof a));
+    if (!TestExact(t) && m_inPlace && m_poolBlits) {
+        m_poolBlits = 0;
+        TestClear(yb);
+        Blit(0, yb, 256, 1, row);
+        TestWhite(yb);
+        t = TestRow(yb, 2);
+        snprintf(line + strlen(line), sizeof line - strlen(line), " -> vitaGL's copy: %s",
+                 TestText(t, b, sizeof b));
+    }
+    fprintf(stderr, "[gl] self-test: %s\n", line);
+
+    /* movie pictures: an RGBA picture drawn by the present program, from a pool texture */
+    int ym = kTestY + 7;
+    uint32_t rgba[256];
+    for (int u = 0; u < 256; u++) {
+        uint16_t q = TestTexel(u, 3);
+        rgba[u] = (uint32_t)m_to8[q & 31] | (uint32_t)m_to8[(q >> 5) & 31] << 8 |
+                  (uint32_t)m_to8[(q >> 10) & 31] << 16 | 0xff000000u;
+    }
+    line[0] = 0;
+    int ip = m_inPlace && m_poolImages ? PoolTake(m_imagePool, kImagePool, 256, 1, GL_RGBA) : -1;
+    if (ip >= 0) {
+        memcpy(m_imagePool[ip].ptr, rgba, sizeof rgba);
+        TestPicture(m_imagePool[ip].tex, 1.0f, 1.0f, ym);
+        TestWhite(ym);
+        t = TestRow(ym, 3);
+        FreeOwn(&m_imagePool[ip], 1);   /* (read back: the GPU is done) */
+        snprintf(line, sizeof line, "movie pictures (pool): %s", TestText(t, a, sizeof a));
+        if (!TestExact(t))
+            m_poolImages = 0;
+    }
+    if (ip < 0 || !m_poolImages) {
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, m_dispTex);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 256, 1, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+        TestPicture(m_dispTex, 256.0f / VRAM_W, 1.0f / VRAM_H, ym);
+        TestWhite(ym);
+        t = TestRow(ym, 3);
+        glBindTexture(GL_TEXTURE_2D, m_dispTex);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, m_filter ? GL_LINEAR : GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, m_filter ? GL_LINEAR : GL_NEAREST);
+        snprintf(line + strlen(line), sizeof line - strlen(line), "%smovie pictures (vitaGL's copy): %s",
+                 line[0] ? " -> " : "", TestText(t, b, sizeof b));
+    }
+    fprintf(stderr, "[gl] self-test: %s\n", line);
+
+    /* nothing left behind: the test page and rows blank, the cache empty, the counts at 0 */
+    g_textureStore.Upload(kTestPageX, kTestPageY, 256, 4, zero);
+    Fill(0, kTestY, VRAM_W, VRAM_H - kTestY, 0);
+    memset(m_slot, 0, sizeof m_slot);
+    m_lastSlot = -1;
+    int on = m_st.on;
+    m_st = Stats{};
+    m_st.on = on;
+    fprintf(stderr, "[gl] self-test done: texture cache %s, store %s, blits %s, movie pictures %s\n",
+            !m_cacheOn ? "off" : m_atlasTex.bias ? "with an address fix" :
+            m_atlasFix[0] ? "with a shader fix" : m_atlasW == 4096 ? "4096x2048" : "2048x4096",
+            m_nstore ? "own copies" : "vitaGL's", m_inPlace && m_poolBlits ? "pool" : "vitaGL's",
+            m_inPlace && m_poolImages ? "pool" : "vitaGL's");
+}
 #endif
 
