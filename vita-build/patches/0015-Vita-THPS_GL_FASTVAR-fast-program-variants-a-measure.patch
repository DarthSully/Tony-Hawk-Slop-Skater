 /* 16-bit pixels the CPU wrote (GlGpu::Blit) into a render target: the same LUMINANCE_ALPHA
  * texture as the texture store's, their VRAM x, y at its 0, 0. */
 static const char *gl_copy_fs =
diff --git a/platform/pc/src/pc_gpu_gl.cpp b/platform/pc/src/pc_gpu_gl.cpp
index 35d6e14..d687c29 100644
--- a/platform/pc/src/pc_gpu_gl.cpp
+++ b/platform/pc/src/pc_gpu_gl.cpp
@@ -615,7 +615,15 @@ int GlGpu::Init(int fixed_scale, int out_w, int out_h)
     m_locSlow = DrawLocs{m_drawUPass, m_drawUDpass, m_drawUProj, m_drawUTarget, m_drawUShift,
                          m_drawUUvfix};
     if (m_cacheOn && draw_fs == gl_draw_fs) {
-        m_drawProgFast = Program(gl_draw_vs, gl_draw_fast_fs);
+        static const char *const fast_fs[5] = { gl_draw_fast_fs, gl_draw_fast_fs1, gl_draw_fast_fs2,
+                                                gl_draw_fast_fs3, gl_draw_fast_fs4 };
+        const char *fv = getenv("THPS_GL_FASTVAR");
+        int var = fv ? atoi(fv) : 0;
+        if (var < 0 || var > 4)
+            var = 0;
+        if (var)
+            fprintf(stderr, "[gl] THPS_GL_FASTVAR=%d: fast program variant (a measurement)\n", var);
+        m_drawProgFast = Program(gl_draw_vs, fast_fs[var]);
         if (m_drawProgFast) {
             glUseProgram(m_drawProgFast);
             glUniform1i(glGetUniformLocation(m_drawProgFast, "u_vram"), 0);
@@ -975,6 +983,14 @@ void GlGpu::Flush()
 
 #ifdef PC_GLES
     UseDraw(slow_tris == 0);
+    if (slow_tris == 0 && m_drawProgFast) {
+        m_st.fast_batches++;
+        m_st.fast_tris += b.nv / 3;
+    } else {
+        m_st.slow_batches++;
+        m_st.slow_tris += b.nv / 3;
+        m_st.uncached_tris += m_cacheOn ? slow_tris : 0;
+    }
 #else
     glUseProgram(m_drawProg);
 #endif
@@ -1530,6 +1546,14 @@ void GlGpu::LayerDraw(int first, int count, int cls, uint16_t hd)
     if (m_cacheOn && l.verts == m_layerConv)
