+        m_st.fast_batches++;
+        m_st.fast_tris += count / 3;
+    } else {
+        m_st.slow_batches++;
+        m_st.slow_tris += count / 3;
+        m_st.uncached_tris += m_cacheOn ? slow_tris : 0;
+    }
     m_proj[0] = l.lp.ofs_x + l.lp.ofx;
     m_proj[1] = l.lp.ofs_y + l.lp.ofy;
     m_proj[2] = l.lp.h;
@@ -2064,9 +2088,12 @@ void GlGpu::Present(void *sdl_window, int x, int y, int w, int h, int enabled,
 #endif
