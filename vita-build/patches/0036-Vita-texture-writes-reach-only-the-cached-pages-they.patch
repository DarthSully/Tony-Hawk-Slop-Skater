     void DecodeRow(const CacheSlot &c, int y, uint32_t *out);
diff --git a/platform/pc/src/pc_gpu_gl.cpp b/platform/pc/src/pc_gpu_gl.cpp
index 835ff0b..6a3da00 100644
--- a/platform/pc/src/pc_gpu_gl.cpp
+++ b/platform/pc/src/pc_gpu_gl.cpp
@@ -858,6 +858,14 @@ int GlGpu::Init(int fixed_scale, int out_w, int out_h)
     {
         const char *tc = getenv("THPS_GL_TEXCACHE");
         m_cacheOn = !(tc && tc[0] == '0');
+        const char *pi = getenv("THPS_GL_PRECISEINV"), *pa = getenv("THPS_GL_PARTIAL");
+        m_preciseInv = !(pi && pi[0] == '0');
+        m_partial = !(pa && pa[0] == '0');
+        fprintf(stderr, "[gl] texture cache writes: %s, %s, %s\n",
+                m_preciseInv ? "exact rectangles (THPS_GL_PRECISEINV=0: 16x16 cells)" : "16x16 cells",
+                m_partial ? "pages updated in place (THPS_GL_PARTIAL=0: freed)" : "pages freed",
