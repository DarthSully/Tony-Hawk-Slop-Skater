index 1990134..c93ed13 100644
--- a/platform/pc/include/pc/gl_gpu.h
+++ b/platform/pc/include/pc/gl_gpu.h
@@ -198,6 +198,10 @@ class GlGpu {
     void LayerEnd();
     void HdForget(uint16_t h);
     void TexturesChanging(int x, int y, int w, int h);
+    /* t31: x, y, w, h of the store were just written (exact, not rounded to its 16x16 cells), or
