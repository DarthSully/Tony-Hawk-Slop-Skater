         const char *dm = getenv("THPS_GL_DECODEMS");
         m_decodeBudgetUs = (dm ? atoi(dm) : 25) * 1000LL;
         const char *lv = getenv("THPS_GL_LAYERVBO");
@@ -1170,7 +1178,7 @@ void GlGpu::UploadTexStore()
                     m_cellGen[cy * CELLS_X + run]++;
                 }
                 m_st.tex_ups++;
-                if (m_cacheOn)
+                if (m_cacheOn && !m_preciseInv)
                     CacheInvalidate(cx * CELL, cy * CELL, (run - cx) * CELL, CELL);
                 any = 1;
                 cx = run;
@@ -1202,7 +1210,7 @@ void GlGpu::UploadTexStore()
             int x = cx * CELL, y = cy * CELL;
             m_st.tex_ups++;
 #ifdef PC_GLES
-            if (m_cacheOn)
+            if (m_cacheOn && !m_preciseInv)
                 CacheInvalidate(x, y, (run - cx) * CELL, CELL);
 #endif
 #ifdef PC_GLES
@@ -1784,6 +1792,54 @@ void GlGpu::TexturesChanging(int x, int y, int w, int h)
             m_drawn[cy][cx] = 0;
 }
 
+/* t31: a write's exact rectangle against the cached pages. t30's dips in levels (16-30 fps, 150-220
+ * pages decoded a second) came from each small write throwing away every page it touched,
+ * rounded up to 16x16 cells: a palette row took every page using a CLUT in the same 16 rows.
+ * Texels written to a page drawn lately: its rows decoded again where it sits (8-row bands, as
+ * m_slotTransp), the slot and the layers' vertices stay good. A CLUT, a window, a page wrapping at
+ * VRAM's edge, a big write or a page not drawn lately: freed as before. */
+void GlGpu::TexturesWritten(int x, int y, int w, int h)
+{
+#ifdef PC_GLES
+    if (!m_active || !m_cacheOn || !m_preciseInv)
+        return;
+    for (int s = 0; s < kCacheSlots; s++) {
+        CacheSlot &c = m_slot[s];
+        if (!c.key)
+            continue;
+        bool texels = false;
+        if (y < c.y + 256 && c.y < y + h)
+            texels = (x < c.x + c.w && c.x < x + w) ||
+                     (x < c.x + c.w - VRAM_W && c.x - VRAM_W < x + w);
+        bool clut = c.cw && c.cy >= y && c.cy < y + h && x < c.cx + c.cw && c.cx < x + w;
+        if (!texels && !clut)
+            continue;
+#ifdef __vita__
+        int y0 = (y > c.y ? y - c.y : 0) & ~7, y1 = (y + h - 1 - c.y < 255 ? y + h - 1 - c.y : 255) | 7;
+        if (m_partial && !clut && (uint32_t)(c.key >> 32) == 0xffffu && c.x + c.w <= VRAM_W &&
+            y1 - y0 < 64 && m_frameNo - c.frame < 4) {
+            uint32_t row[256];
+            for (int b = y0 >> 3; b <= y1 >> 3; b++)
+                m_slotTransp[s][b] = 0;
+            for (int r = y0; r <= y1; r++) {
+                DecodeRow(c, r, row);
+                memcpy(AtlasRow(s, r), row, sizeof row);
+                TranspRow(s, r, row);
+            }
+            m_st.cache_partial++;
+            continue;
+        }
+#endif
+        m_st.cache_inval++;
+        m_cacheGen++;
+        c.key = 0;
+    }
+    m_lastSlot = -1;
+#else
+    (void)x, (void)y, (void)w, (void)h;
+#endif
+}
+
 /* ---------------------------------------------------------------------------------------------
  * HD textures (pc_dctex.h) */
 
@@ -3499,7 +3555,8 @@ void GlGpu::Present(void *sdl_window, int x, int y, int w, int h, int enabled,
                         "GL draws %.0f a frame; 3D %.0f draws a frame (new draw for depth %d, "
                         "class %d, texture %d, 2D between %d, layer end %d); 3D layers in a "
                         "buffer %d, 3D draws not %d, batched %d; framebuffer binds %.0f a frame; opaque batched tris %d without discard, "
-                        "%d with, %d colour runs (%d batches over 48)\n",
+                        "%d with, %d colour runs (%d batches over 48); texture writes: %d skipped as "
+                        "the same bytes, %d pages updated in place, %d freed\n",
                 m_st.draws, m_st.readbacks, m_st.tex_ups, m_st.blits, m_st.cache_hits,
                 m_st.cache_misses, m_st.cache_inval, m_st.cache_full, m_st.cache_deferred,
                 m_st.cache_stale, m_st.fast_batches, m_st.fast_tris, m_st.slow_batches,
@@ -3510,7 +3567,7 @@ void GlGpu::Present(void *sdl_window, int x, int y, int w, int h, int enabled,
                 m_st.split[PC_GL_SPLIT_TEXTURE], m_st.split[PC_GL_SPLIT_2D],
                 m_st.split[PC_GL_SPLIT_END], m_st.layer_bufs, m_st.layer_client,
                 m_st.layer_batches, s_fbBinds / 60.0, m_st.solid_tris, m_st.cut_tris, m_st.colour_runs,
-                m_st.colour_unordered);
+                m_st.colour_unordered, m_st.cache_same, m_st.cache_partial, m_st.cache_inval);
         s_fbBinds = 0;
         m_st = Stats{};
         m_st.on = 1;
diff --git a/platform/pc/src/pc_texstore.cpp b/platform/pc/src/pc_texstore.cpp
index 551c214..bc3b1fa 100644
--- a/platform/pc/src/pc_texstore.cpp
+++ b/platform/pc/src/pc_texstore.cpp
@@ -1,5 +1,6 @@
 /* The texture store (pc_texstore.h): the texels at the game's coordinates, and which 16x16 cells
  * changed since the renderer last uploaded them (pc_gpu_gl.cpp). */
+#include <stdlib.h>
 #include <string.h>
 
 #include "pc_texstore.h"
@@ -40,10 +41,31 @@ void TextureStore::Upload(int x, int y, int w, int h, const void *src) {
     int sw = w;
     if (x < 0 || y < 0 || !Clip(x, y, w, h))
         return;
+    /* t31: the game loads the same palettes and images again and again (t30's level dips: ~10
+     * cached pages thrown away a frame); bytes already there change nothing. THPS_GL_SAMEBYTES=0
+     * writes them anyway */
+    static int same = -1;
+    if (same < 0) {
+        const char *e = getenv("THPS_GL_SAMEBYTES");
+        same = !(e && e[0] == '0');
+    }
+    if (same) {
+        int j = 0;
+        while (j < h && !memcmp(&m_tex[y + j][x], s + j * sw, (size_t)w * 2))
+            j++;
+        if (j == h) {
+            for (int cy = y / kTexCell; cy <= (y + h - 1) / kTexCell; cy++)
+                for (int cx = x / kTexCell; cx <= (x + w - 1) / kTexCell; cx++)
+                    m_cell[cy][cx] |= kTexUsed;
+            g_glGpu.TexturesSame();
+            return;
+        }
+    }
     g_glGpu.TexturesChanging(x, y, w, h);
     for (int j = 0; j < h; j++)
         memcpy(&m_tex[y + j][x], s + j * sw, (size_t)w * 2);
     Mark(x, y, w, h);
+    g_glGpu.TexturesWritten(x, y, w, h);
 }
 
 void TextureStore::Read(int x, int y, int w, int h, void *dst) {
@@ -64,6 +86,7 @@ void TextureStore::Fill(int x, int y, int w, int h, uint32_t rgb) {
         for (int i = 0; i < w; i++)
             m_tex[y + j][x + i] = c;
     Mark(x, y, w, h);
+    g_glGpu.TexturesWritten(x, y, w, h);
 }
 
 }   // namespace pc
