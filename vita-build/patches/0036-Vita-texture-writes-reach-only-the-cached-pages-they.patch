+    void TexturesSame() { m_st.cache_same++; }
     void Blit(int x, int y, int w, int h, const uint16_t *src);
     void Read(int x, int y, int w, int h, uint16_t *out);
     void Present(void *sdl_window, int x, int y, int w, int h, int enabled,
@@ -247,6 +251,7 @@ class GlGpu {
         int fast_batches, slow_batches, fast_tris, slow_tris, uncached_tris;
         int store_cells, store_switches, store_copies, blit_pool, blit_copies;
         int cache_stale, own_fixed;
+        int cache_same, cache_partial;  /* t31: writes skipped (same bytes), slots updated in place */
         int gl_draws, layer_draws, split[PC_GL_SPLITS];
         int layer_bufs, layer_client;   /* 3D layers drawn from a buffer; 3D draws not */
         int layer_batches;              /* t20: 3D draws made by LayerBatch */
@@ -430,6 +435,9 @@ private:
     /* before: if given, the count before each triangle (n / 3 + 1 entries) */
     int CacheVerts(GlVert *v, int n, uint32_t *before = nullptr);
     void CacheInvalidate(int x, int y, int w, int h);
+    /* t31 (THPS_GL_PRECISEINV=0: by 16x16 cells at the next Prepare, which reached every CLUT in
+     * those 16 rows; THPS_GL_PARTIAL=0: no updates in place) */
+    bool m_preciseInv = true, m_partial = true;
     void CacheRefresh();
