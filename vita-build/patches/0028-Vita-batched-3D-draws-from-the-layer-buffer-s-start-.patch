From 4822c1fff99558cfbcb2ac869ef8e16c01743aff Mon Sep 17 00:00:00 2001
From: vita-build <vita@build>
Date: Wed, 28 Oct 2026 09:56:04 +0300
Subject: [PATCH] Vita: batched 3D draws from the layer buffer's start (the
 16-bit attribute offset wrapped), batch checks, the log appends

- t22's LayerBatch pointed the vertex attributes at each run's first vertex. With every
  attribute in one buffer vitaGL draws a packed stream from the buffer's start and puts each
  attribute pointer's byte offset into GXM's attribute offset, which is 16 bits: past
  65536 / 36 = 1820 vertices it wrapped, and the runs drew earlier faces' vertices (opaque
  faces missing, the skater only as his shadow, the level see-through). In a buffer the
  attributes now stay at offset 0, as LayerDraw's, and the indices are the layer's vertex
  numbers (up to 65536, unsigned short); from client memory they start at the run's first.
- Checks before each batch: whole triangles, inside the layer, highest index below the vertex
  count, index count = vertex count. A failure logs "[r3d] batch ... CHECK FAILED ..." and
  turns batching off for the rest of the run (DrawUpto draws as with THPS_R3D_BATCH=0). The
  first 3 frames' batches are logged (opaque/semi/subtractive tris, indices, highest, vertices).
- ux0:data/THPS/thps.log appends: a blank line and "===== YYYY-MM-DD HH:MM:SS =====" (the
  Vita's local time) at each launch; over 4 MB at launch it becomes thps.old.log first.
---
 platform/pc/README.md           |   3 +-
 platform/pc/include/pc/gl_gpu.h |  16 +--
 platform/pc/src/pc_gpu_gl.cpp   | 167 ++++++++++++++++++++------------
 platform/pc/src/pc_render3d.cpp |  10 +-
 platform/pc/src/pc_vita.cpp     |  22 ++++-
 5 files changed, 144 insertions(+), 74 deletions(-)

diff --git a/platform/pc/README.md b/platform/pc/README.md
index 583410f..6fbf497 100644
--- a/platform/pc/README.md
+++ b/platform/pc/README.md
@@ -262,7 +262,8 @@ demangler, `build/psyq_names.tsv`). To run it on the console:
   The first start extracts `Data/` next to it (about 630 MB; the image can be deleted afterwards).
 - vitaGL compiles the renderer's shaders at runtime: `ur0:data/libshacccg.suprx` must be present
   (extracted from the firmware with ShaRKBR33D or the like).
-- `ux0:data/THPS/thps.log` is the log (written straight through, so it survives a crash);
+- `ux0:data/THPS/thps.log` is the log (written straight through, so it survives a crash; each
+  launch appends after a `===== date time =====` line, and over 4 MB it moves to `thps.old.log`);
   `ux0:data/THPS/env.txt` holds `NAME=value` lines that stand in for environment variables
   (`THPS_TRACE=1` ...). Saves go in `ux0:data/THPS` too.
 
diff --git a/platform/pc/include/pc/gl_gpu.h b/platform/pc/include/pc/gl_gpu.h
index d06dd69..e7be80d 100644
--- a/platform/pc/include/pc/gl_gpu.h
+++ b/platform/pc/include/pc/gl_gpu.h
@@ -190,10 +190,11 @@ class GlGpu {
      * depth buffer: the opaque ones' true depth, then their colour against it (the decal
      * tolerance, painter order within it), then the semi-transparent ones in their order. cls:
      * the classes present, bit 1 << cls (0 opaque, 1 semi-transparent, 2 subtractive). No HD
-     * textures (those faces keep LayerDraw). */
-    void LayerBatch(int first, int count, int cls, int why);
-    /* LayerBatch can draw (t21: its programs compiled; t22: always) */
-    bool BatchOk() const { return true; }
+     * textures (those faces keep LayerDraw). false: not drawn, batching is off (t23's checks
+     * failed; the caller draws them as before). */
+    bool LayerBatch(int first, int count, int cls, int why);
+    /* LayerBatch can draw (t21: its programs compiled; t22: always; t23: until a check fails) */
+    bool BatchOk() const { return !m_batchOff; }
     void LayerEnd();
     void HdForget(uint16_t h);
     void TexturesChanging(int x, int y, int w, int h);
@@ -234,6 +235,7 @@ class GlGpu {
         const GlVert *verts;   /* LayerBegin's, or their copy with the cache's slots */
         const GlVert *src;     /* LayerBegin's */
         GLuint buf;            /* verts in a buffer of graphics memory (0: drawn from verts) */
+        int nv;                /* LayerBegin's vertex count */
         uint32_t conv_gen;     /* m_cacheGen when verts got their slots (all at LayerBegin) */
 #endif
     };
@@ -366,9 +368,11 @@ class GlGpu {
     };
     GLuint m_drawProgFast = 0;
     DrawLocs m_locSlow = {}, m_locFast = {};
-    /* t22: LayerBatch's index lists (opaque, semi-transparent, subtractive) for one window */
-    static constexpr int kBatchWindow = 65532;
+    /* t22: LayerBatch's index lists (opaque, semi-transparent, subtractive). t23: vertex numbers
+     * of the layer's buffer, its attributes at offset 0 (see LayerBatch) */
     std::vector<uint16_t> m_batchIdx[3];
+    bool m_batchOff = false;
+    int m_batchLogFrames = 0, m_batchLogged = 0;   /* t23: [r3d] batch lines, the first frames */
     long long m_decodeUs = 0, m_decodeBudgetUs = 25000;   /* this frame's decoding; THPS_GL_DECODEMS */
     float m_proj[4] = {};
     int m_projSet = 0, m_projApplied[2] = {};
diff --git a/platform/pc/src/pc_gpu_gl.cpp b/platform/pc/src/pc_gpu_gl.cpp
index 1f77be9..6f1465f 100644
--- a/platform/pc/src/pc_gpu_gl.cpp
+++ b/platform/pc/src/pc_gpu_gl.cpp
@@ -2403,6 +2403,7 @@ void GlGpu::LayerBegin(const GlLayerParams *lp, const GlVert *v, int nv)
      * GPU once */
     l.verts = l.src = v;
     l.buf = 0;
+    l.nv = nv;
     if (m_cacheOn && nv > 0 && nv <= MAX_VERTS) {
         memcpy(m_layerConv, v, (size_t)nv * sizeof(GVert));
         l.verts = m_layerConv;
@@ -2547,21 +2548,20 @@ void GlGpu::LayerDraw(int first, int count, int cls, uint16_t hd, int depth, int
     glDisable(GL_BLEND);
 }
 
-void GlGpu::LayerBatch(int first, int count, int cls, int why)
+bool GlGpu::LayerBatch(int first, int count, int cls, int why)
 {
 #ifndef PC_GLES
     (void)first, (void)count, (void)cls, (void)why;
+    return false;
 #else
 #ifdef __vita__
     PC_VITA_PROF_SCOPE(PC_PROF_DRAW);
 #endif
     Layer &l = m_layer;
+    if (m_batchOff)
+        return false;
     if (!l.active || count <= 0)
-        return;
-    m_st.layer_draws++;
-    m_st.layer_batches++;
-    if (why >= 0 && why < PC_GL_SPLITS)
-        m_st.split[why]++;
+        return true;
     Flush();
     Prepare();
     int slow_tris = 1;
@@ -2575,6 +2575,62 @@ void GlGpu::LayerBatch(int first, int count, int cls, int why)
             buf = 0;
         }
     }
+    /* t22: no shader of our own (vitaGL's compiler took no change to the draw vertex shader,
+     * t20/t21): the classes are index lists into the layer's vertices.
+     * t23: t22 pointed the attributes at the run's first vertex. With every attribute in one
+     * buffer vitaGL draws them as one packed stream from the buffer's start and puts each
+     * attribute pointer's byte offset into GXM's attribute offset, which is 16 bits: past
+     * 65536 / 36 = 1820 vertices it wrapped and the runs drew other faces' vertices (opaque
+     * faces gone, the level see-through). In a buffer the attributes now stay at offset 0 (as
+     * LayerDraw's) and the indices are the layer's vertex numbers (MAX_VERTS = 65536 fits
+     * unsigned short); from client memory vitaGL copies from the pointer up to the highest
+     * index, so there they start at first and the indices count from it. */
+    int base = buf ? 0 : first;
+    for (int c = 0; c < 3; c++)
+        m_batchIdx[c].clear();
+    const char *bad = nullptr;
+    int maxIdx = -1, nverts = buf ? l.nv : count;
+    if (count % 3)
+        bad = "a run that is not whole triangles";
+    else if (first < 0 || first + count > l.nv)
+        bad = "a run past the layer's vertices";
+    else if (first + count - base > 65536)
+        bad = "vertex numbers past unsigned short";
+    for (int t = first; !bad && t < first + count; t += 3) {
+        uint16_t info = l.verts[t].info;
+        int c = !(info & PC_GL_I_SEMI) ? 0 : ((info >> 5) & 3) == 2 ? 2 : 1;
+        if (!(cls & 1 << c))
+            c = 0;   /* (never: DrawUpto gave the classes present) */
+        m_batchIdx[c].push_back((uint16_t)(t - base));
+        m_batchIdx[c].push_back((uint16_t)(t + 1 - base));
+        m_batchIdx[c].push_back((uint16_t)(t + 2 - base));
+        maxIdx = t + 2 - base;
+    }
+    const std::vector<uint16_t> &op = m_batchIdx[0], &se = m_batchIdx[1], &sb = m_batchIdx[2];
+    if (!bad && maxIdx >= nverts)
+        bad = "highest index >= vertex count";
+    if (!bad && (int)(op.size() + se.size() + sb.size()) != count)
+        bad = "index count != vertex count";
+    if (m_batchLogFrames == 0)
+        m_batchLogFrames = (int)m_frameNo;
+    if (bad || ((int)m_frameNo - m_batchLogFrames < 3 && m_batchLogged < 48)) {
+        m_batchLogged++;
+        fprintf(stderr, "[r3d] batch frame %u: vertices %d..%d of %d (%s, base %d), opaque tris "
+                "%d, semi %d, subtractive %d, indices %d, highest %d of %d%s%s\n",
+                (unsigned)m_frameNo, first, first + count - 1, l.nv, buf ? "buffer" : "client",
+                base, (int)op.size() / 3, (int)se.size() / 3, (int)sb.size() / 3,
+                (int)(op.size() + se.size() + sb.size()), maxIdx, nverts,
+                bad ? ": CHECK FAILED, batching off for this run of the game: " : "",
+                bad ? bad : "");
+    }
+    if (bad) {
+        m_batchOff = true;
+        return false;
+    }
+    m_st.layer_draws++;
+    m_st.layer_batches++;
+    if (why >= 0 && why < PC_GL_SPLITS)
+        m_st.split[why]++;
     if (!buf)
         m_st.layer_client++;
     float proj[4] = { (float)l.lp.ofs_x + l.lp.ofx, (float)l.lp.ofs_y + l.lp.ofy, l.lp.h,
@@ -2598,69 +2654,56 @@ void GlGpu::LayerBatch(int first, int count, int cls, int why)
     glDepthFunc(GL_LEQUAL);
     Target *ts[MAX_SURFACES + 1];
     int nt = LayerTargets(ts);
-    /* t22: no shader of our own (vitaGL's compiler took no change to the draw vertex shader,
-     * t20/t21): the classes are index lists into the layer's vertices, each window of up to
-     * 65532 vertices drawn from attributes that start at its first */
-    for (int w0 = first; w0 < first + count; w0 += kBatchWindow) {
-        int wn = first + count - w0 < kBatchWindow ? first + count - w0 : kBatchWindow;
-        for (int c = 0; c < 3; c++)
-            m_batchIdx[c].clear();
-        for (int t = 0; t < wn; t += 3) {
-            uint16_t info = l.verts[w0 + t].info;
-            int c = !(info & PC_GL_I_SEMI) ? 0 : ((info >> 5) & 3) == 2 ? 2 : 1;
-            if (!(cls & 1 << c))
-                c = 0;   /* (never: DrawUpto gave the classes present) */
-            m_batchIdx[c].push_back((uint16_t)t);
-            m_batchIdx[c].push_back((uint16_t)(t + 1));
-            m_batchIdx[c].push_back((uint16_t)(t + 2));
-        }
-        DrawAttribsFrom(buf, buf ? nullptr : l.verts, w0);
-        for (int i = 0; i < nt; i++) {
-            ts[i]->Use();
-            if (!ts[i]->Scissor(l.clip[0], l.clip[1], l.clip[2], l.clip[3], l.wide))
-                continue;
-            DrawUniforms(ts[i]);
-            int n = 0;
-            const std::vector<uint16_t> &op = m_batchIdx[0], &se = m_batchIdx[1], &sb = m_batchIdx[2];
-            if (!op.empty()) {
-                /* the opaque faces' true depth (texels the shader discards write none), then
-                 * their colour where it is within the tolerance of the nearest: a decal over its
-                 * floor passes, and the later of the two (the PS1's order) is the one left */
-                SetBlend(0);
-                DPass(1);
-                glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
-                glDepthMask(GL_TRUE);
-                glDrawElements(GL_TRIANGLES, (GLsizei)op.size(), GL_UNSIGNED_SHORT, op.data());
-                glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
-                glDepthMask(GL_FALSE);
-                DPass(0);
-                glDrawElements(GL_TRIANGLES, (GLsizei)op.size(), GL_UNSIGNED_SHORT, op.data());
-                n += 2;
-            }
+    if (!buf)
+        DrawAttribsFrom(0, l.verts, first);
+    else if (m_attrBuf != buf)
+        DrawAttribsFrom(buf, nullptr);
+    for (int i = 0; i < nt; i++) {
+        ts[i]->Use();
+        if (!ts[i]->Scissor(l.clip[0], l.clip[1], l.clip[2], l.clip[3], l.wide))
+            continue;
+        DrawUniforms(ts[i]);
+        int n = 0;
+        if (!op.empty()) {
+            /* the opaque faces' true depth (texels the shader discards write none), then
+             * their colour where it is within the tolerance of the nearest: a decal over its
+             * floor passes, and the later of the two (the PS1's order) is the one left */
+            SetBlend(0);
+            DPass(1);
+            glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+            glDepthMask(GL_TRUE);
+            glDrawElements(GL_TRIANGLES, (GLsizei)op.size(), GL_UNSIGNED_SHORT, op.data());
+            glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
             glDepthMask(GL_FALSE);
-            if (!se.empty()) {
-                /* semi-transparent faces after every opaque one, in their own order */
-                SetBlend(0);
-                glDrawElements(GL_TRIANGLES, (GLsizei)se.size(), GL_UNSIGNED_SHORT, se.data());
-                n++;
-            }
-            if (!sb.empty()) {
-                /* subtractive (B-F): after the other semi-transparent ones */
-                SetBlend(1);
-                glDrawElements(GL_TRIANGLES, (GLsizei)sb.size(), GL_UNSIGNED_SHORT, sb.data());
-                SetBlend(2);
-                glDrawElements(GL_TRIANGLES, (GLsizei)sb.size(), GL_UNSIGNED_SHORT, sb.data());
-                n += 2;
-            }
-            m_st.draws++;
-            m_st.gl_draws += n;
+            DPass(0);
+            glDrawElements(GL_TRIANGLES, (GLsizei)op.size(), GL_UNSIGNED_SHORT, op.data());
+            n += 2;
+        }
+        glDepthMask(GL_FALSE);
+        if (!se.empty()) {
+            /* semi-transparent faces after every opaque one, in their own order */
+            SetBlend(0);
+            glDrawElements(GL_TRIANGLES, (GLsizei)se.size(), GL_UNSIGNED_SHORT, se.data());
+            n++;
         }
+        if (!sb.empty()) {
+            /* subtractive (B-F): after the other semi-transparent ones */
+            SetBlend(1);
+            glDrawElements(GL_TRIANGLES, (GLsizei)sb.size(), GL_UNSIGNED_SHORT, sb.data());
+            SetBlend(2);
+            glDrawElements(GL_TRIANGLES, (GLsizei)sb.size(), GL_UNSIGNED_SHORT, sb.data());
+            n += 2;
+        }
+        m_st.draws++;
+        m_st.gl_draws += n;
     }
-    m_attrBuf = 0;   /* (the attributes start elsewhere now: bound again at the next draw) */
+    if (!buf)
+        m_attrBuf = 0;   /* (client memory: bound again at the next draw) */
     glDisable(GL_DEPTH_TEST);
     glDepthMask(GL_TRUE);
     glDisable(GL_SCISSOR_TEST);
     glDisable(GL_BLEND);
+    return true;
 #endif
 }
 
diff --git a/platform/pc/src/pc_render3d.cpp b/platform/pc/src/pc_render3d.cpp
index a0def8c..51c59aa 100644
--- a/platform/pc/src/pc_render3d.cpp
+++ b/platform/pc/src/pc_render3d.cpp
@@ -1261,10 +1261,12 @@ void Renderer3D::DrawUpto(uint32_t bucket, int last)
         if (!hd) {
             int first = (int)b->sf[i].first;
             int count = (int)(b->sf[j - 1].first + b->sf[j - 1].nv) - first;
-            g_glGpu.LayerBatch(first, count, cls, j < b->nf ? PC_GL_SPLIT_2D : PC_GL_SPLIT_END);
-            m_st.draws++;
-            b->next = j;
-            return;
+            if (g_glGpu.LayerBatch(first, count, cls, j < b->nf ? PC_GL_SPLIT_2D : PC_GL_SPLIT_END)) {
+                m_st.draws++;
+                b->next = j;
+                return;
+            }
+            m_batch = 0;   /* t23: a check failed (GlGpu::LayerBatch logged why): the draws below */
         }
     }
     while (i < b->nf && b->sf[i].bucket >= bucket) {
diff --git a/platform/pc/src/pc_vita.cpp b/platform/pc/src/pc_vita.cpp
index 6915000..5e54806 100644
--- a/platform/pc/src/pc_vita.cpp
+++ b/platform/pc/src/pc_vita.cpp
@@ -12,6 +12,7 @@
 #include <psp2/kernel/clib.h>
 #include <psp2/kernel/processmgr.h>
 #include <psp2/power.h>
+#include <psp2/rtc.h>
 #include <psp2/kernel/threadmgr.h>
 #include <malloc.h>
 #include <vitaGL.h>
@@ -135,7 +136,26 @@ void PC_VitaLogOpen(void) {
     sceIoMkdir("ux0:data", 0777);
     sceIoMkdir(PC_VITA_DIR, 0777);
     LoadEnv();
-    g_logFd = sceIoOpen(PC_VITA_DIR "/thps.log", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0666);
+    /* t23: each launch appends, after a blank line and the Vita's local time; over 4 MB at
+     * launch the log becomes thps.old.log (replacing the last one) and a new one starts */
+    {
+        SceIoStat ls;
+        if (sceIoGetstat(PC_VITA_DIR "/thps.log", &ls) >= 0 && ls.st_size > 4 * 1024 * 1024) {
+            sceIoRemove(PC_VITA_DIR "/thps.old.log");
+            sceIoRename(PC_VITA_DIR "/thps.log", PC_VITA_DIR "/thps.old.log");
+        }
+    }
+    g_logFd = sceIoOpen(PC_VITA_DIR "/thps.log", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_APPEND, 0666);
+    if (g_logFd >= 0) {
+        SceDateTime dt;
+        char head[64];
+        memset(&dt, 0, sizeof dt);
+        sceRtcGetCurrentClockLocalTime(&dt);
+        int n = snprintf(head, sizeof head, "\n===== %04u-%02u-%02u %02u:%02u:%02u =====\n",
+                         (unsigned)dt.year, (unsigned)dt.month, (unsigned)dt.day,
+                         (unsigned)dt.hour, (unsigned)dt.minute, (unsigned)dt.second);
+        sceIoWrite(g_logFd, head, n);
+    }
     const char *sync = getenv("THPS_LOG_SYNC");
     if (g_logFd >= 0 && !(sync && atoi(sync))) {
         /* below the game thread's priority, so a line never takes the game thread's core */
-- 
