 }
 
+/* t30: a name's bucket folder under Data (bk00-bk63) */
+static void BucketName(const char *name, char *out, int n) {
+    uint32_t h = 2166136261u;
+    for (const char *p = name; *p; p++)
+        h = (h ^ (uint8_t)(*p >= 'A' && *p <= 'Z' ? *p + 32 : *p)) * 16777619u;
+    snprintf(out, n, "bk%02u", (unsigned)(h % 64));
+}
+
+bool Assets::Present(const char *rel, char *path, int n) {
+    Path(path, n, rel);
+    if (os::IsFile(path))
+        return true;
+    if (strchr(rel, '\\') || strchr(rel, '/'))
+        return false;   /* (only files at Data's top are moved) */
+    char b[8], r[MAX_PATH];
+    BucketName(rel, b, sizeof b);
+    snprintf(r, sizeof r, "%s\\%s", b, rel);
+    Path(path, n, r);
+    return os::IsFile(path);
+}
+
+/* t30: the card looks a file up in a folder slowly when the folder is big: Data's ~2000 files
+ * cost 250-800 ms an open (t29), each load. In 64 subfolders each holds ~30. Renames only; a
+ * file is in one place or the other at any moment, so a start that stops part way (a crash, the
+ * time cap) finishes at the next. On by default on the Vita (Sully, t30); THPS_DATA_BUCKETS=0
+ * leaves Data as it is, =undo moves them back, =1 does it elsewhere too;
+ * THPS_DATA_BUCKETS_SECS (default 60) caps a start's work. Manifest.txt keeps the old paths:
+ * Present looks in both places. */
+void Assets::Buckets() {
+    const char *e = getenv("THPS_DATA_BUCKETS");
+#ifdef __vita__
+    if (e && e[0] == '0')
+        return;
+#else
+    if (!e || !e[0] || e[0] == '0')
+        return;
+#endif
+    bool undo = e && !_stricmp(e, "undo");
+    const char *cs = getenv("THPS_DATA_BUCKETS_SECS");
+    int64_t cap = (int64_t)(cs ? atoi(cs) : 60) * os::ClockFreq();
+    int64_t t0 = os::ClockNow();
+    char path[MAX_PATH], line[MAX_PATH], from[MAX_PATH], to[MAX_PATH], b[8], r[MAX_PATH];
+    int moved = 0, left = 0;
+    Path(path, sizeof path, "Manifest.txt");
+    FILE *f = fopen(path, "r");
+    if (!f)
+        return;
+    if (!undo)
+        for (int i = 0; i < 64; i++) {
+            snprintf(r, sizeof r, "bk%02d", i);
+            MakeDirs(r);
+        }
+    while (fgets(line, sizeof line, f)) {
+        line[strcspn(line, "\r\n")] = 0;
+        if (!line[0] || line[0] == '#' || strchr(line, '\\') || strchr(line, '/'))
+            continue;
+        BucketName(line, b, sizeof b);
+        snprintf(r, sizeof r, "%s\\%s", b, line);
+        Path(undo ? to : from, MAX_PATH, line);
+        Path(undo ? from : to, MAX_PATH, r);
+        if (!os::IsFile(from))
+            continue;
+        if (os::ClockNow() - t0 > cap) {
+            left++;
+            continue;
+        }
+        if (rename(from, to) == 0) {
+            moved++;
+            if (moved % 250 == 0)
+                PC_Log("data buckets: %d files %s, %.1f s", moved, undo ? "moved back" : "moved",
+                       (double)(os::ClockNow() - t0) / (double)os::ClockFreq());
+        }
+    }
+    fclose(f);
+    if (undo && !left)
+        for (int i = 0; i < 64; i++) {
+            snprintf(r, sizeof r, "bk%02d", i);
+            Path(path, sizeof path, r);
+            rmdir(path);   /* (only when empty) */
+        }
+    if (!moved && !left)
+        return;   /* (done at an earlier start: nothing to say) */
+    PC_Log("data buckets: %s %d files in %.1f s%s", undo ? "moved back" : "moved", moved,
+           (double)(os::ClockNow() - t0) / (double)os::ClockFreq(),
+           left ? " (time cap reached: the rest at the next start)" : "");
+    if (left)
+        PC_Log("data buckets: %d files still to move", left);
+}
+
 void Assets::MakeDirs(const char *rel) {
     char p[MAX_PATH];
     Path(p, sizeof p, rel);
