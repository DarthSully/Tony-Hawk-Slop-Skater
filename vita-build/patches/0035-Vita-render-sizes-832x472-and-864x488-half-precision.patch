--- a/platform/pc/src/pc_assets.cpp
+++ b/platform/pc/src/pc_assets.cpp
@@ -33,6 +33,12 @@
 #include <stdlib.h>
 #include <ctype.h>
 #include <string.h>
+#ifdef _WIN32
+#include <direct.h>
