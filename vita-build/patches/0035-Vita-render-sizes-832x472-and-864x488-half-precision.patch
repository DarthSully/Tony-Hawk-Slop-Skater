     if (m_dc) {
         DreamcastFixups();
diff --git a/platform/pc/src/pc_gpu_gl.cpp b/platform/pc/src/pc_gpu_gl.cpp
index 5de4b06..835ff0b 100644
--- a/platform/pc/src/pc_gpu_gl.cpp
+++ b/platform/pc/src/pc_gpu_gl.cpp
@@ -3689,6 +3689,7 @@ void GlGpu::SolidProgram()
         }
         fs.erase(at, strlen(c));
     }
+    m_solidFs = fs;
     GLuint p = Program(gl_draw_vs, fs.c_str());
     if (!p) {
         fprintf(stderr, "[gl] opaque no-discard program: REJECTED by the compiler, off (source above)\n");
@@ -3736,6 +3737,51 @@ void GlGpu::SolidProgram()
     glUseProgram(m_drawProg);
     m_drawProgDepth = d;
     fprintf(stderr, "[gl] depth-pass program: ok (THPS_GL_DEPTHFS=0 turns it off)\n");
+    SolidHalf();
+}
+
+/* t30: the no-discard program with its colour maths in half precision (mediump: the texel,
+ * the vertex colour, the blend weight; the texel coordinates stay highp, the atlas is 4096
+ * wide). Compiled last of all; rejected, the full-precision one stays. THPS_GL_HALF=0: not
+ * built */
+void GlGpu::SolidHalf()
+{
+    const char *e = getenv("THPS_GL_HALF");
+    if ((e && e[0] == '0') || !m_drawProgSolid || m_solidFs.empty()) {
+        fprintf(stderr, "[gl] half-precision colour: off%s\n", e && e[0] == '0' ? " (THPS_GL_HALF=0)" : "");
+        return;
+    }
+    static const char *const pairs[][2] = {
+        { "    vec3 c = v_color;\n", "    mediump vec3 c = v_color;\n" },
+        { "        vec4 tx = texture2D(u_hd, v_uv / 256.0);\n", "        mediump vec4 tx = texture2D(u_hd, v_uv / 256.0);\n" },
+        { "        vec4 ta = texture2D(u_atlas,", "        mediump vec4 ta = texture2D(u_atlas," },
+        { "    float keep = 0.0;\n", "    mediump float keep = 0.0;\n" },
+    };
+    std::string fs = m_solidFs;
+    for (auto &pr : pairs) {
+        size_t at = fs.find(pr[0]);
+        if (at == std::string::npos) {
+            fprintf(stderr, "[gl] half-precision colour: the shader has changed, off\n");
+            return;
+        }
+        fs.replace(at, strlen(pr[0]), pr[1]);
+    }
+    GLuint p = Program(gl_draw_vs, fs.c_str());
+    if (!p) {
+        fprintf(stderr, "[gl] half-precision colour: REJECTED by the compiler, full precision kept (source above)\n");
+        glUseProgram(m_drawProg);
+        return;
+    }
+    glUseProgram(p);
+    glUniform1i(glGetUniformLocation(p, "u_vram"), 0);
+    glUniform1i(glGetUniformLocation(p, "u_hd"), 1);
+    glUniform1i(glGetUniformLocation(p, "u_atlas"), kAtlasUnit);
+    m_locSolid = DrawLocs{glGetUniformLocation(p, "u_pass"), glGetUniformLocation(p, "u_dpass"),
+                          glGetUniformLocation(p, "u_proj"), glGetUniformLocation(p, "u_target"),
+                          glGetUniformLocation(p, "u_shift"), glGetUniformLocation(p, "u_uvfix")};
+    glUseProgram(m_drawProg);
+    m_drawProgSolid = p;
+    fprintf(stderr, "[gl] half-precision colour: ok, opaque faces without discard (THPS_GL_HALF=0 turns it off)\n");
 }
 
