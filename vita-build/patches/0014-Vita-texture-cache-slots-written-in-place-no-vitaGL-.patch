From a5cd8eb2486e0a9b0df0591476ca50d111cb60bd Mon Sep 17 00:00:00 2001
From: vita-build <vita@build>
Date: Sat, 24 Oct 2026 18:07:56 +0300
Subject: [PATCH] Vita: texture cache slots written in place (no vitaGL texture
 copies), 128 slots, a fast draw program, positive texel wrap

---
 platform/pc/include/pc/gl_gpu.h          |  14 ++-
 platform/pc/include/pc/gl_shaders_gles.h |  93 ++++++++++++++++++--
 platform/pc/include/pc/platform.h        |   2 +-
 platform/pc/src/pc_gpu_gl.cpp            | 106 +++++++++++++++++++----
 platform/pc/src/pc_vita.cpp              |   4 +-
 5 files changed, 191 insertions(+), 28 deletions(-)

diff --git a/platform/pc/include/pc/gl_gpu.h b/platform/pc/include/pc/gl_gpu.h
