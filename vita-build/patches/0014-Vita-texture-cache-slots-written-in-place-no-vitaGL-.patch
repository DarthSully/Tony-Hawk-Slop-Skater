+    GLuint m_drawProgFast = 0;
+    DrawLocs m_locSlow = {}, m_locFast = {};
+    float m_proj[4] = {};
+    int m_projSet = 0, m_projApplied[2] = {};
+    void UseDraw(int fast);
     CacheSlot m_slot[kCacheSlots] = {};
     uint32_t m_frameNo = 1;
     int m_lastSlot = -1;
@@ -315,7 +325,7 @@ class GlGpu {
     GlVert m_layerConv[MAX_VERTS];   /* a layer's vertices with their slots (LayerBegin's are const) */
     int CacheSlotFor(uint32_t key);
     void CacheDecode(int s);
-    void CacheVerts(GlVert *v, int n);
+    int CacheVerts(GlVert *v, int n);
