+++ b/platform/pc/include/pc/gl_gpu.h
@@ -305,9 +305,19 @@ class GlGpu {
         int x, y, w;         /* its texels in VRAM (halfwords) */
         int cx, cy, cw;      /* its CLUT (cw 0: 15-bit, none) */
     };
-    static constexpr int kCacheSlots = 64, kAtlas = 2048, kAtlasUnit = 4;
+    static constexpr int kCacheSlots = 128, kAtlasW = 4096, kAtlasH = 2048, kAtlasUnit = 4;
     int m_cacheOn = 0;
     GLuint m_atlas = 0;
+    uint8_t *m_atlasPtr = nullptr;   /* the atlas's texels (vglGetTexDataPointer), written in place */
+    /* the draw programs' uniforms; m_drawU* are the bound program's (UseDraw) */
