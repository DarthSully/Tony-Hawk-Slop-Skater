      * textures (those faces keep LayerDraw). */
     void LayerBatch(int first, int count, int cls, int why);
+    /* LayerBatch can draw (its programs compiled) */
+    bool BatchOk() const { return m_drawProgBatch != 0; }
     void LayerEnd();
     void HdForget(uint16_t h);
     void TexturesChanging(int x, int y, int w, int h);
@@ -263,7 +266,10 @@ class GlGpu {
     void SetBlend(int pass);
     /* the draw program's u_dpass (a float in ES 2) */
 #ifdef PC_GLES
-    void DPass(int d, int sel = 0) { glUniform1f(m_drawUDpass, (float)(d + 2 * sel)); }
+    void DPass(int d) { glUniform1f(m_drawUDpass, (float)d); }
+    /* the batch programs' u_sel (LayerBatch): 0 all faces, 1 opaque, 2 semi-transparent,
