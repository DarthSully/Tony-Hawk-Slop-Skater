 #else
     void DPass(int d) { glUniform1i(m_drawUDpass, d); }
 #endif
@@ -358,13 +364,21 @@ class GlGpu {
     uint8_t *m_atlasPtr = nullptr;   /* the atlas's texels (m_atlasTex on the Vita), written in place */
     /* the draw programs' uniforms; m_drawU* are the bound program's (UseDraw) */
     struct DrawLocs {
-        GLint pass, dpass, proj, target, shift, uvfix;
+        GLint pass, dpass, proj, target, shift, uvfix, sel;
     };
     GLuint m_drawProgFast = 0;
     DrawLocs m_locSlow = {}, m_locFast = {};
+    /* t21: LayerBatch's programs, the draw program's with u_sel (compiled last, after every
+     * program t17 had: when vitaGL's compiler rejects them, batching is off and the rest works) */
+    GLuint m_drawProgBatch = 0, m_drawProgBatchFast = 0;
+    DrawLocs m_locBatch = {}, m_locBatchFast = {};
+    GLint m_drawUSel = -1;
+    std::string m_batchVs;
+    const char *m_fastFs = nullptr;
+    void BatchPrograms(const char *draw_fs, const char *fast_fs);
     float m_proj[4] = {};
-    int m_projSet = 0, m_projApplied[2] = {};
-    void UseDraw(int fast);
+    int m_projSet = 0, m_projApplied[4] = {};
+    void UseDraw(int fast, int batch = 0);
     CacheSlot m_slot[kCacheSlots] = {};
     uint32_t m_frameNo = 1;
     int m_lastSlot = -1;
