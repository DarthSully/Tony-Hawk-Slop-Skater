     }
@@ -810,7 +818,7 @@ int GlGpu::Init(int fixed_scale, int out_w, int out_h)
         m_lastSlot = -1;
     }
     m_locSlow = DrawLocs{m_drawUPass, m_drawUDpass, m_drawUProj, m_drawUTarget, m_drawUShift,
-                         m_drawUUvfix};
+                         m_drawUUvfix, -1};
     if (m_cacheOn && draw_fs == gl_draw_fs) {
         static const char *const fast_fs[5] = { gl_draw_fast_fs, gl_draw_fast_fs1, gl_draw_fast_fs2,
                                                 gl_draw_fast_fs3, gl_draw_fast_fs4 };
@@ -821,6 +829,7 @@ int GlGpu::Init(int fixed_scale, int out_w, int out_h)
         if (var)
             fprintf(stderr, "[gl] THPS_GL_FASTVAR=%d: fast program variant (a measurement)\n", var);
         m_drawProgFast = Program(gl_draw_vs, fast_fs[var]);
+        m_fastFs = fast_fs[var];
         if (m_drawProgFast) {
             glUseProgram(m_drawProgFast);
             glUniform1i(glGetUniformLocation(m_drawProgFast, "u_vram"), 0);
@@ -831,10 +840,11 @@ int GlGpu::Init(int fixed_scale, int out_w, int out_h)
                                  glGetUniformLocation(m_drawProgFast, "u_proj"),
                                  glGetUniformLocation(m_drawProgFast, "u_target"),
                                  glGetUniformLocation(m_drawProgFast, "u_shift"),
-                                 glGetUniformLocation(m_drawProgFast, "u_uvfix")};
+                                 glGetUniformLocation(m_drawProgFast, "u_uvfix"), -1};
             glUseProgram(m_drawProg);
         }
     }
+    BatchPrograms(draw_fs, m_drawProgFast && draw_fs == gl_draw_fs ? m_fastFs : nullptr);
     AtlasUniforms();
     fprintf(stderr, "[gl] texture cache: %s%s\n",
             m_cacheOn ? "on (128 pages of 256x256, THPS_GL_TEXCACHE=0 turns it off)" : "off",
@@ -2426,7 +2436,7 @@ void GlGpu::LayerDraw(int first, int count, int cls, uint16_t hd, int depth, int
     if (!m_projSet || memcmp(proj, m_proj, sizeof proj)) {
         memcpy(m_proj, proj, sizeof proj);
         m_projSet = 1;
-        m_projApplied[0] = m_projApplied[1] = 0;
+        m_projApplied[0] = m_projApplied[1] = m_projApplied[2] = m_projApplied[3] = 0;
     }
     UseDraw(slow_tris == 0);
     if (slow_tris == 0 && m_drawProgFast) {
@@ -2534,10 +2544,10 @@ void GlGpu::LayerBatch(int first, int count, int cls, int why)
     if (!m_projSet || memcmp(proj, m_proj, sizeof proj)) {
         memcpy(m_proj, proj, sizeof proj);
         m_projSet = 1;
-        m_projApplied[0] = m_projApplied[1] = 0;
+        m_projApplied[0] = m_projApplied[1] = m_projApplied[2] = m_projApplied[3] = 0;
     }
-    UseDraw(slow_tris == 0);
-    if (slow_tris == 0 && m_drawProgFast) {
+    UseDraw(slow_tris == 0, 1);
+    if (slow_tris == 0 && m_drawProgBatchFast) {
         m_st.fast_batches++;
         m_st.fast_tris += count / 3;
     } else {
@@ -2565,13 +2575,14 @@ void GlGpu::LayerBatch(int first, int count, int cls, int why)
              * colour where it is within the tolerance of the nearest: a decal over its floor
              * passes, and the later of the two (the PS1's order) is the one left */
             SetBlend(0);
-            DPass(1, 1);
+            Sel(1);
+            DPass(1);
             glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
             glDepthMask(GL_TRUE);
             glDrawArrays(GL_TRIANGLES, first, count);
             glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
             glDepthMask(GL_FALSE);
-            DPass(0, 1);
+            DPass(0);
             glDrawArrays(GL_TRIANGLES, first, count);
             n += 2;
         }
@@ -2579,20 +2590,20 @@ void GlGpu::LayerBatch(int first, int count, int cls, int why)
         if (cls & 2) {
             /* semi-transparent faces after every opaque one, in their own order */
             SetBlend(0);
-            DPass(0, 2);
+            Sel(2);
             glDrawArrays(GL_TRIANGLES, first, count);
             n++;
         }
         if (cls & 4) {
             /* subtractive (B-F): after the other semi-transparent ones */
-            DPass(0, 3);
+            Sel(3);
             SetBlend(1);
             glDrawArrays(GL_TRIANGLES, first, count);
             SetBlend(2);
             glDrawArrays(GL_TRIANGLES, first, count);
             n += 2;
         }
-        DPass(0);
+        Sel(0);
         m_st.draws++;
         m_st.gl_draws += n;
     }
@@ -3279,11 +3290,18 @@ void GlGpu::QuadAttribs(const float *v, int stride_floats, int uv)
 
 /* the draw program for a batch (fast: every textured triangle has a slot), its uniforms in
  * m_drawU*, and the layer projection it hasn't had yet */
-void GlGpu::UseDraw(int fast)
+void GlGpu::UseDraw(int fast, int batch)
 {
     int f = fast && m_drawProgFast ? 1 : 0;
-    glUseProgram(f ? m_drawProgFast : m_drawProg);
-    const DrawLocs &l = f ? m_locFast : m_locSlow;
+    if (batch && m_drawProgBatch)
+        f = fast && m_drawProgBatchFast ? 3 : 2;
+    static const GLuint GlGpu::*const progs[4] = { &GlGpu::m_drawProg, &GlGpu::m_drawProgFast,
+                                                   &GlGpu::m_drawProgBatch,
+                                                   &GlGpu::m_drawProgBatchFast };
+    const DrawLocs *locs[4] = { &m_locSlow, &m_locFast, &m_locBatch, &m_locBatchFast };
+    glUseProgram(this->*progs[f]);
+    const DrawLocs &l = *locs[f];
+    m_drawUSel = l.sel;
     m_drawUPass = l.pass;
     m_drawUDpass = l.dpass;
     m_drawUProj = l.proj;
@@ -3352,9 +3370,76 @@ void GlGpu::SlotFill(CacheSlot &c, uint64_t key)
     c.cw = depth == 0 ? 16 : depth == 1 ? 256 : 0;
 }
 
+/* t21: the batch programs. Their vertex shader is the draw program's (t17's, which vitaGL's
+ * compiler takes) with a uniform u_sel and, at the end of main, a block in the plainest GLSL that
+ * moves the triangles of the other classes outside the clip volume. Compiled after every other
+ * program (t20's single changed shader failed on the Vita, with no log, and every compile after it
+ * failed too): if they fail, LayerBatch is off and the rest is as in t17. */
+void GlGpu::BatchPrograms(const char *draw_fs, const char *fast_fs)
+{
+    static const char decl[] = "uniform float u_dpass;\n";
+    static const char tail[] = "    v_uvr = a_uvr;\n}\n";
+    static const char sel[] =
+        "    v_uvr = a_uvr;\n"
+        "    if (u_sel > 0.5) {\n"
+        "        float fsemi = bits(info, 11.0, 1.0);\n"
+        "        float fabr = bits(info, 5.0, 2.0);\n"
+        "        float fcls = 1.0;\n"
+        "        if (fsemi > 0.5) {\n"
+        "            fcls = 2.0;\n"
+        "            if (fabr > 1.5) {\n"
+        "                if (fabr < 2.5) {\n"
+        "                    fcls = 3.0;\n"
+        "                }\n"
+        "            }\n"
+        "        }\n"
+        "        if (abs(fcls - u_sel) > 0.5) {\n"
+        "            gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n"
+        "        }\n"
+        "    }\n"
+        "}\n";
+    const char *bt = getenv("THPS_R3D_BATCH");
+    if (bt && atoi(bt) == 0)
+        return;   /* (not even compiled) */
+    std::string vs = gl_draw_vs;
+    size_t d = vs.find(decl), t = vs.rfind(tail);
+    if (d == std::string::npos || t == std::string::npos || t + sizeof tail - 1 != vs.size()) {
+        fprintf(stderr, "[gl] batch shader: the draw shader has changed, batching off\n");
+        return;
+    }
+    vs.replace(t, sizeof tail - 1, sel);
+    vs.insert(d + sizeof decl - 1, "uniform float u_sel;\n");
+    m_batchVs = vs;
+    auto locs = [](GLuint p) {
+        return DrawLocs{glGetUniformLocation(p, "u_pass"), glGetUniformLocation(p, "u_dpass"),
+                        glGetUniformLocation(p, "u_proj"), glGetUniformLocation(p, "u_target"),
+                        glGetUniformLocation(p, "u_shift"), glGetUniformLocation(p, "u_uvfix"),
+                        glGetUniformLocation(p, "u_sel")};
+    };
+    m_drawProgBatch = Program(m_batchVs.c_str(), draw_fs);
+    if (m_drawProgBatch && fast_fs)
+        m_drawProgBatchFast = Program(m_batchVs.c_str(), fast_fs);
+    GLuint progs[2] = { m_drawProgBatch, m_drawProgBatchFast };
+    for (int i = 0; i < 2; i++) {
+        GLuint p = progs[i];
+        if (!p)
+            continue;
+        glUseProgram(p);
+        glUniform1i(glGetUniformLocation(p, "u_vram"), 0);
+        glUniform1i(glGetUniformLocation(p, "u_hd"), 1);
+        glUniform1i(glGetUniformLocation(p, "u_atlas"), kAtlasUnit);
+        (i ? m_locBatchFast : m_locBatch) = locs(p);
+        glUniform1f((i ? m_locBatchFast : m_locBatch).sel, 0.0f);
+    }
+    glUseProgram(m_drawProg);
+    fprintf(stderr, "[gl] batch shader: %s%s\n",
+            m_drawProgBatch ? "ok" : "REJECTED by the compiler, batching off (t17's draws)",
+            m_drawProgBatch && fast_fs && !m_drawProgBatchFast ? " (no fast variant)" : "");
+}
+
 void GlGpu::AtlasUniforms()
 {
-    GLuint progs[2] = { m_drawProg, m_drawProgFast };
+    GLuint progs[4] = { m_drawProg, m_drawProgFast, m_drawProgBatch, m_drawProgBatchFast };
     for (GLuint p : progs) {
         if (!p)
             continue;
diff --git a/platform/pc/src/pc_render3d.cpp b/platform/pc/src/pc_render3d.cpp
