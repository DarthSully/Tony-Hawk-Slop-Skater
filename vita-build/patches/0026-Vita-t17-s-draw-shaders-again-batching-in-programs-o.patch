+        /* t21: its source, numbered, so that a failure is never blind */
+        int line = 1;
+        for (const char *q = src; *q && line <= 200; line++) {
+            const char *e = strchr(q, '\n');
+            int len = e ? (int)(e - q) : (int)strlen(q);
