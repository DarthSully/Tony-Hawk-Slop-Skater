@@ -89,7 +85,7 @@ static const char *gl_draw_vs =
      * linear); everything else at the near end, always passing. A layer's faces nearer than its
      * near plane are clipped, as gl_ClipDistance did */
     "    if (sky) gl_Position.z = gl_Position.w;\n"
-    "    else if (view && dpass > 0.5) gl_Position.z = clipZ(w, 0.0);\n"
+    "    else if (view && u_dpass > 0.5) gl_Position.z = clipZ(w, 0.0);\n"
     "    else if (view || dflag) gl_Position.z = clipZ(w, 1.0 / 256.0);\n"
     "    else gl_Position.z = -0.9999 * gl_Position.w;\n"
     "    v_color = a_color.rgb;\n"
@@ -105,11 +101,6 @@ static const char *gl_draw_vs =
     "    v_flags = vec4(bits(info, 11.0, 1.0), view ? 1.0 : 0.0, cached, u_shift);\n"
     "    v_twin = a_twin;\n"
