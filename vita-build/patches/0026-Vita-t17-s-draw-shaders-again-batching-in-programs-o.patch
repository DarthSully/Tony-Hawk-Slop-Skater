-    "    if (sel > 0.5) {\n"
-    "        float abr = bits(info, 5.0, 2.0);\n"
-    "        float fcls = bits(info, 11.0, 1.0) < 0.5 ? 1.0 : (abr > 1.5 && abr < 2.5 ? 3.0 : 2.0);\n"
-    "        if (abs(fcls - sel) > 0.5) gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n"
-    "    }\n"
     "}\n";
 
 /* THPS_GL_FLAT=1 (a measurement): the vertex colour only, no texture lookups and no discard. The
diff --git a/platform/pc/src/pc_gpu_gl.cpp b/platform/pc/src/pc_gpu_gl.cpp
index b187c2f..b93768c 100644
--- a/platform/pc/src/pc_gpu_gl.cpp
+++ b/platform/pc/src/pc_gpu_gl.cpp
@@ -114,6 +114,14 @@ GLuint Compile(GLenum type, const char *src)
