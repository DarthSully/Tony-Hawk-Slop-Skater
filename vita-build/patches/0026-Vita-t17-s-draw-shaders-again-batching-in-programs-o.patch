     m_showStats = getenv("THPS_R3DSTATS") && atoi(getenv("THPS_R3DSTATS"));
@@ -1468,7 +1468,7 @@ void Renderer3D::Init(int gl)
         g_precise.Enable(true);
 #ifdef __vita__
     fprintf(stderr, "[r3d] 3D: %s%s\n", m_native ? "native" : "PS1",
-            m_native ? (m_batch ? ", batched (THPS_R3D_BATCH=0: t17's draws)" : ", t17's draws (THPS_R3D_BATCH=0)") : "");
+            m_native ? (m_batch ? ", batched (THPS_R3D_BATCH=0: t17's draws)" : ", t17's draws (batching off)") : "");
 #else
     fprintf(stderr, "[r3d] 3D: %s\n", m_native ? "native" : "PS1 (THPS_RENDER3D=psx)");
