+/* row y of slot s's decoded texels: its 8x8 cells that hold a transparent one (0) */
+void GlGpu::TranspRow(int s, int y, const uint32_t *row)
+{
+    uint32_t bits = 0;
+    for (int x = 0; x < 256; x++)
+        if (!row[x])
+            bits |= 1u << (x >> 3);
+    m_slotTransp[s][y >> 3] |= bits;
+}
