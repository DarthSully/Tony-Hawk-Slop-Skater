+/* t24: the fast program with no discard at all, for LayerBatch's opaque faces no texel of which is
+ * transparent (TriSolid), drawn without blending: a program that can discard makes the GPU shade
+ * every pixel of every face, hidden or not. Its source is gl_draw_fast_fs without the three
+ * discards (the vertex shader is untouched). Compiled after every other program (t20: after a
+ * rejected one vitaGL's compiler failed the rest): rejected, the faces keep the fast program.
+ * THPS_GL_NODISCARD=0: not built. */
+void GlGpu::SolidProgram()
+{
+    const char *nd = getenv("THPS_GL_NODISCARD"), *bt = getenv("THPS_R3D_BATCH");
+    if (!m_drawProgFast || m_prepass || (nd && nd[0] == '0') || (bt && atoi(bt) == 0)) {
+        fprintf(stderr, "[gl] opaque no-discard program: off%s\n",
+                !m_drawProgFast ? " (no fast program)" : m_prepass ? " (THPS_R3D_PREPASS=1)" : "");
+        return;
+    }
+    static const char *const cut[3] = {
+        "        if (tx.a < 0.03) discard;\n",
+        "        if (ta.a < 0.25) discard;\n",
+        "    if ((u_pass > 0.5 && u_pass < 1.5 && blend) || (u_pass > 1.5 && !blend)) discard;\n",
+    };
+    std::string fs = gl_draw_fast_fs;
+    for (const char *c : cut) {
+        size_t at = fs.find(c);
+        if (at == std::string::npos) {
+            fprintf(stderr, "[gl] opaque no-discard program: the fast shader has changed, off\n");
+            return;
+        }
+        fs.erase(at, strlen(c));
+    }
+    GLuint p = Program(gl_draw_vs, fs.c_str());
+    if (!p) {
+        fprintf(stderr, "[gl] opaque no-discard program: REJECTED by the compiler, off (source above)\n");
+        glUseProgram(m_drawProg);
+        return;
+    }
+    glUseProgram(p);
+    glUniform1i(glGetUniformLocation(p, "u_vram"), 0);
+    glUniform1i(glGetUniformLocation(p, "u_hd"), 1);
+    glUniform1i(glGetUniformLocation(p, "u_atlas"), kAtlasUnit);
+    m_locSolid = DrawLocs{glGetUniformLocation(p, "u_pass"), glGetUniformLocation(p, "u_dpass"),
+                          glGetUniformLocation(p, "u_proj"), glGetUniformLocation(p, "u_target"),
+                          glGetUniformLocation(p, "u_shift"), glGetUniformLocation(p, "u_uvfix")};
+    glUseProgram(m_drawProg);
