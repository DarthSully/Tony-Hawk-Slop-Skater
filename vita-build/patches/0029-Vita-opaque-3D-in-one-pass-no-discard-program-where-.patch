+bool GlGpu::TriSolid(const GlVert *v) const
+{
+    if (!(v->info & PC_GL_I_TEXTURED))
+        return true;
+    if (!(v->clut & 0x8000) || ((v->info >> 7) & 3) == 3)
+        return false;
+    int s = v->clut & 127;
+    int x0 = v->uvr[0] >> 3, y0 = v->uvr[1] >> 3, x1 = v->uvr[2] >> 3, y1 = v->uvr[3] >> 3;
+    if (x1 < x0 || y1 < y0)
+        return false;
+    uint32_t mask = (x1 - x0 == 31 ? 0xffffffffu : ((1u << (x1 - x0 + 1)) - 1)) << x0;
+    for (int y = y0; y <= y1; y++)
+        if (m_slotTransp[s][y] & mask)
+            return false;
+    return true;
+}
