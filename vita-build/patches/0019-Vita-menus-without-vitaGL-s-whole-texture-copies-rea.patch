     };
     static constexpr int kCacheSlots = 128, kAtlasW = 4096, kAtlasH = 2048, kAtlasUnit = 4;
+    /* new pages decoded a frame at most; the rest keep the emulated lookup a frame or two (a
+     * level's first frame wanted 89 at once: 0.77 s) */
+    static constexpr int kDecodesPerFrame = 8;
+    uint32_t m_decodeFrame = 0;
+    int m_decodesLeft = 0;
     int m_cacheOn = 0;
     GLuint m_atlas = 0;
     uint8_t *m_atlasPtr = nullptr;   /* the atlas's texels (vglGetTexDataPointer), written in place */
@@ -332,6 +340,34 @@ class GlGpu {
     int CacheVerts(GlVert *v, int n);
     void CacheInvalidate(int x, int y, int w, int h);
     void CacheRefresh();
+#ifdef __vita__
+    /* vitaGL copies a whole texture before writing one that a draw of the last 4 frames used
+     * (glTexSubImage2D): 1 MB for the store or a blit, from memory the CPU reads slowly. The
+     * textures written while frames are drawn are written in place instead, each time into a
+     * texture no such draw used. The store keeps up to kStoreVersions copies, each knowing which
+     * of the store's 16x16 cells it has (a write generation per cell): a write after a draw goes to
+     * a free copy, which takes the cells it lacks. The CPU's blits and the movies' pictures each take
+     * a free texture of a pool. With none free, it is vitaGL's copy again. */
+    static constexpr int kStoreVersions = 8, kBlitPool = 6, kImagePool = 5;
+    struct InPlace {
+        GLuint tex;
+        uint8_t *ptr;    /* its texels (vglGetTexDataPointer): linear rows of align(w, 8) texels */
+        uint32_t used;   /* m_frameNo when last drawn with (0: never) */
+        int w, h;
+    };
+    InPlace m_store[kStoreVersions] = {};   /* [0] is m_texstore */
+    uint32_t m_storeGen[kStoreVersions][CELLS_Y * CELLS_X] = {};
+    uint32_t m_cellGen[CELLS_Y * CELLS_X] = {};
+    int m_inPlace = 1;   /* THPS_GL_INPLACE=0: vitaGL's copies, as before t12 */
+    int m_nstore = 0, m_storeCur = 0, m_storeDrawn = 0;
+    InPlace m_blitPool[kBlitPool] = {};
+    InPlace m_imagePool[kImagePool] = {};
+    uint8_t *m_basePtr = nullptr;   /* the base target's texels: row y is VRAM row y */
+    /* a free texture of a pool (no draw of the last 4 frames used it), w x h of fmt, made the first
+     * time; -1 when none is */
+    int PoolTake(InPlace *pool, int n, int w, int h, GLenum fmt);
+    void StoreSync();
+#endif
 #endif
     GLuint m_dispTex = 0;                  /* RGBA8 1024x512: pictures shown instead (movies) */
     int m_filter = 0;
