         for (int cx = 0; cx < CELLS_X;) {
@@ -829,6 +891,115 @@ void GlGpu::Prepare()
 #endif
 }
 
+void GlGpu::BindStore()
+{
+    glActiveTexture(GL_TEXTURE0);
+#ifdef __vita__
+    if (m_nstore) {
+        m_store[m_storeCur].used = m_frameNo;
+        m_storeDrawn = 1;
+        glBindTexture(GL_TEXTURE_2D, m_store[m_storeCur].tex);
+        return;
+    }
+#endif
+    glBindTexture(GL_TEXTURE_2D, m_texstore);
+}
+
+#ifdef __vita__
+/* The cells written since into a copy of the store's texture no draw in flight reads: the current
+ * one until a draw uses it, then a free one (made up to kStoreVersions), which takes every cell it
+ * lacks; with none free, the current one through glTexSubImage2D, which vitaGL copies first. */
+void GlGpu::StoreSync()
+{
+    long long prof_t0 = PC_VitaProfNow();
+    const uint16_t *tex = g_textureStore.Data();
+    int k = m_storeCur;
+    if (m_storeDrawn) {
+        k = -1;
+        for (int i = 0; i < m_nstore && k < 0; i++)
+            if (i != m_storeCur && (!m_store[i].used || m_frameNo - m_store[i].used > 4))
+                k = i;
+        if (k < 0 && m_nstore < kStoreVersions) {
+            InPlace &n = m_store[m_nstore];
+            glActiveTexture(GL_TEXTURE0);
+            n.tex = Texture(GL_LUMINANCE_ALPHA, VRAM_W, VRAM_H, GL_LUMINANCE_ALPHA, GL_UNSIGNED_BYTE,
+                            GL_NEAREST);
+            n.ptr = (uint8_t *)vglGetTexDataPointer(GL_TEXTURE_2D);
+            n.w = VRAM_W;
+            n.h = VRAM_H;
+            n.used = 0;
+            if (n.ptr) {
+                memset(m_storeGen[m_nstore], 0, sizeof m_storeGen[m_nstore]);
+                k = m_nstore++;
+            } else {
+                glDeleteTextures(1, &n.tex);
+                n = InPlace{};
+            }
+        }
+        if (k >= 0) {
+            m_storeCur = k;
+            m_storeDrawn = 0;
+            m_st.store_switches++;
+        }
+    }
+    int cur = k >= 0 ? k : m_storeCur;
+    uint8_t *texels = m_store[cur].ptr;
+    uint32_t *gen = m_storeGen[cur];
+    if (k < 0) {
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, m_store[cur].tex);
+    }
+    for (int cy = 0; cy < CELLS_Y; cy++) {
+        uint32_t *g = gen + cy * CELLS_X;
+        const uint32_t *now = m_cellGen + cy * CELLS_X;
+        for (int cx = 0; cx < CELLS_X;) {
+            if (g[cx] == now[cx]) {
+                cx++;
+                continue;
+            }
+            int run = cx;
+            for (; run < CELLS_X && g[run] != now[run]; run++)
+                g[run] = now[run];
+            int x = cx * CELL, y = cy * CELL, w = (run - cx) * CELL;
+            if (k < 0)
+                Upload16(x, y, w, CELL, tex + (size_t)y * VRAM_W + x, VRAM_W);
+            else
+                for (int j = y; j < y + CELL; j++)   /* L the low byte, A the high: as stored */
+                    memcpy(texels + ((size_t)j * VRAM_W + x) * 2, tex + (size_t)j * VRAM_W + x,
+                           (size_t)w * 2);
+            m_st.store_cells += run - cx;
+            cx = run;
+        }
+    }
+    if (k < 0) {
+        /* vitaGL wrote a copy: the texels moved, and no draw has used the copy yet */
+        m_store[cur].ptr = (uint8_t *)vglGetTexDataPointer(GL_TEXTURE_2D);
+        m_storeDrawn = 0;
+        m_st.store_copies++;
+    }
+    PC_VitaProfAdd(PC_PROF_UPLOAD, PC_VitaProfNow() - prof_t0);
+}
+
+int GlGpu::PoolTake(InPlace *pool, int n, int w, int h, GLenum fmt)
+{
+    for (int i = 0; i < n; i++) {
+        InPlace &t = pool[i];
+        if (!t.tex) {
+            glActiveTexture(GL_TEXTURE0);
+            t.tex = Texture((GLint)fmt, w, h, fmt, GL_UNSIGNED_BYTE, GL_NEAREST);
+            t.ptr = (uint8_t *)vglGetTexDataPointer(GL_TEXTURE_2D);
+            t.w = w;
+            t.h = h;
+            t.used = 0;
+            return t.ptr ? i : -1;
+        }
+        if (t.ptr && t.w == w && t.h == h && (!t.used || m_frameNo - t.used > 4))
+            return i;
+    }
+    return -1;
+}
+#endif
