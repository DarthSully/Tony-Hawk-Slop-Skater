@@ -586,17 +586,17 @@ static const char *gl_draw_fast_fs4 =
     "}\n";
 
 /* 16-bit pixels the CPU wrote (GlGpu::Blit) into a render target: the same LUMINANCE_ALPHA
- * texture as the texture store's, their VRAM x, y at its 0, 0. */
+ * texture as the texture store's, their VRAM x, y at its 0, 0. Each pixel's texel is found from its
+ * VRAM position, interpolated from the quad's corners, not from gl_FragCoord (vitaGL's is the GPU's
+ * window position, so it hangs on how vitaGL turns render targets over). */
 static const char *gl_copy_fs =
     "#ifdef GL_ES\n"
     "precision highp float;\n"
     "#endif\n"
     "uniform sampler2D u_vram;\n"
-    "uniform vec4 u_map;\n"         /* the target's VRAM x, y; pixels per texel */
-    "uniform vec2 u_src;\n"         /* the pixels' VRAM x, y */
+    "varying vec2 v_src;\n"         /* the pixel's VRAM position less the pixels' x, y */
     "void main() {\n"
-    "    vec2 p = floor(gl_FragCoord.xy / u_map.zw) + u_map.xy - u_src;\n"
-    "    vec4 sx = texture2D(u_vram, (p + 0.5) / vec2(1024.0, 512.0));\n"
+    "    vec4 sx = texture2D(u_vram, (floor(v_src) + 0.5) / vec2(1024.0, 512.0));\n"
     "    vec2 tx = floor(vec2(sx.r, sx.a) * 255.0 + 0.5);\n"
     "    gl_FragColor = vec4(vec3(mod(tx.x, 32.0), floor(tx.x / 32.0) + mod(tx.y, 4.0) * 8.0,\n"
     "                             mod(floor(tx.y / 4.0), 32.0)) / 31.0, tx.y > 127.5 ? 1.0 : 0.0);\n"
@@ -608,8 +608,11 @@ static const char *gl_copy_vs =
     "#endif\n"
     "attribute vec2 a_pos;\n"
     "uniform vec4 u_target;\n"
+    "uniform vec2 u_src;\n"         /* the pixels' VRAM x, y */
+    "varying vec2 v_src;\n"
     "void main() {\n"
     "    gl_Position = vec4((a_pos - u_target.xy) * 2.0 / u_target.zw - 1.0, 0.0, 1.0);\n"
+    "    v_src = a_pos - u_src;\n"
     "}\n";
 
 /* A texture's area onto the bound framebuffer (the window; a target's pixels onto another). */
