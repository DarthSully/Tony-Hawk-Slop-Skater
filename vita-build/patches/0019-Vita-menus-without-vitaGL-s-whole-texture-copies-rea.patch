 #endif
     float x0 = (float)x, x1 = (float)(x + w), y0 = (float)y, y1 = (float)(y + h);
     float q[12] = { x0, y0, x1, y0, x0, y1, x1, y0, x1, y1, x0, y1 };
     glDisable(GL_BLEND);
