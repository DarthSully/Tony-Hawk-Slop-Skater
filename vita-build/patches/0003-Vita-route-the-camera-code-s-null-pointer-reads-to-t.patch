diff --git a/platform/pc/include/pc_game.h b/platform/pc/include/pc_game.h
index e640fae..f633161 100644
--- a/platform/pc/include/pc_game.h
+++ b/platform/pc/include/pc_game.h
@@ -20,6 +20,16 @@ void pc_vdelete(void *vtable, int slot, void *obj);
  * has no GTE; use the geometry maths (pc_geom.h). */
 void PC_GteAsmInPcBuild(void)
     __attribute__((error("GTE asm in the game's code: use the geometry maths (pc_geom.h)")));
+
+/* A pointer the game can leave null (or near it) where retail read and wrote low RAM: the same
+ * address in the low page (64 KB, zero until written; pc_main.cpp), which is where the x86 builds'
+ * fault handler redirects such an access. The PS Vita has no such handler: the sites it was
+ * found at go through this. */
+extern unsigned char *pc_low_page;
+static inline void *PC_LowPtr(void *p) {
+    return (unsigned long)p < 0x10000ul ? (void *)(pc_low_page + (unsigned long)p) : p;
+}
+#define PC_LOW(p) ((__typeof__(p))PC_LowPtr((void *)(p)))
 #ifdef __cplusplus
 }
 template <class T> static inline void pc_delete(T *p) {
