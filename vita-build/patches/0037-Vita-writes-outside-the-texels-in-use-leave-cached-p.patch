+/* t32: a triangle draws from slot s: the box of used texels grows to hold it (GlVert.uvr; a
+ * texture window's texels are anywhere). Rows written while no face used them are decoded
+ * now, if the box reaches them */
+void GlGpu::SlotUse(int s, const GlVert *v)
+{
+    CacheSlot &c = m_slot[s];
+    bool win = (uint32_t)(c.key >> 32) != 0xffffu;
+    int x0 = win ? 0 : v->uvr[0], y0 = win ? 0 : v->uvr[1];
+    int x1 = win ? 255 : v->uvr[2], y1 = win ? 255 : v->uvr[3];
+    if (x0 >= c.ux0 && y0 >= c.uy0 && x1 <= c.ux1 && y1 <= c.uy1)
+        return;
+    c.ux0 = x0 < c.ux0 ? x0 : c.ux0;
+    c.uy0 = y0 < c.uy0 ? y0 : c.uy0;
+    c.ux1 = x1 > c.ux1 ? x1 : c.ux1;
+    c.uy1 = y1 > c.uy1 ? y1 : c.uy1;
+    if (c.sy1 >= c.sy0) {
+        DecodeRows(s, c.sy0, c.sy1);
+        c.sy0 = 256;
+        c.sy1 = -1;
+    }
 }
 
