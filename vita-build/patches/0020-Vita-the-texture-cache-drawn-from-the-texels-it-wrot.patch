+/* ---- files written by a thread of their own (PC_VitaWriteFile) ---- */
+
+namespace {
+struct WriteJob {
+    char path[256];
+    void *data;
+    int size;
+};
+constexpr int kWriteJobs = 4;
+WriteJob g_writeJobs[kWriteJobs];
+int g_writePut, g_writeOut; /* jobs queued (the caller), written (the thread) */
+SceUID g_writeSema = -1;
+
+/* below the log's priority, in pieces of 256 KB: a dump written by the game thread in its rows'
+ * small writes froze t12 at frame 1500 */
+int WriteThread(SceSize, void *) {
+    for (;;) {
+        sceKernelWaitSema(g_writeSema, 1, NULL);
+        WriteJob &j = g_writeJobs[g_writeOut % kWriteJobs];
+        long long t0 = sceKernelGetProcessTimeWide();
+        int done = 0;
+        SceUID fd = sceIoOpen(j.path, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0666);
+        if (fd >= 0) {
+            while (done < j.size) {
+                int n = j.size - done < (256 << 10) ? j.size - done : 256 << 10;
+                int w = sceIoWrite(fd, (char *)j.data + done, n);
+                if (w <= 0)
+                    break;
+                done += w;
+            }
+            sceIoClose(fd);
+        }
+        fprintf(stderr, "[shot] %s: %s, %d KB in %lld ms\n", j.path,
+                done == j.size ? "written" : "write failed", done >> 10,
+                (sceKernelGetProcessTimeWide() - t0) / 1000);
+        free(j.data);
+        __atomic_store_n(&g_writeOut, g_writeOut + 1, __ATOMIC_RELEASE);
+    }
+    return 0;
+}
+} // namespace
+
+int PC_VitaWriteFile(const char *path, void *data, int size) {
+    if (g_writeSema < 0) {
+        SceUID sema = sceKernelCreateSema("thps-write", 0, 0, kWriteJobs, NULL);
+        SceUID th = sceKernelCreateThread("thps-write", WriteThread, 0x10000100 + 20, 0x4000, 0,
+                                          SCE_KERNEL_CPU_MASK_USER_1 | SCE_KERNEL_CPU_MASK_USER_2,
+                                          NULL);
+        if (sema < 0 || th < 0) {
+            free(data);
+            return -1;
+        }
+        g_writeSema = sema;
+        sceKernelStartThread(th, 0, NULL);
+        PC_VitaWatchThread("write", th);
+    }
+    if (g_writePut - __atomic_load_n(&g_writeOut, __ATOMIC_ACQUIRE) >= kWriteJobs) {
+        free(data);
+        return -1;
+    }
+    WriteJob &j = g_writeJobs[g_writePut % kWriteJobs];
+    snprintf(j.path, sizeof j.path, "%s", path);
+    j.data = data;
+    j.size = size;
+    g_writePut++;
+    sceKernelSignalSema(g_writeSema, 1);
+    return 0;
+}
