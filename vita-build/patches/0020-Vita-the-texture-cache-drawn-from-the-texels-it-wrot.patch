+/* A texture the CPU writes in place: its texels are a 4 KB-aligned block of vitaGL's graphics
+ * memory (CDRAM, which the CPU doesn't cache), and vitaGL's descriptor of an 8x8 placeholder of
+ * the format (its filters and wrap too) is pointed at them, so the address written is the one the
+ * GPU reads. For the 4096x2048 texture vitaGL made for the texture cache, the pointer it gave to
+ * the texels was 24 bytes off the GPU's. Nothing may call glTexSubImage2D on these: vitaGL would
+ * write its placeholder. */
+int GlGpu::OwnTexture(InPlace *t, GLenum fmt, int bpp, int w, int h)
+{
+    size_t size = (size_t)((w + 7) & ~7) * h * bpp;
+    *t = InPlace{};
+    t->block = vglAlloc((uint32_t)size + 4096, VGL_MEM_VRAM);
+    if (!t->block)
+        return 0;
+    t->ptr = (uint8_t *)(((uintptr_t)t->block + 4095) & ~(uintptr_t)4095);
+    t->tex = Texture((GLint)fmt, 8, 8, fmt, GL_UNSIGNED_BYTE, GL_NEAREST);
+    t->gxm = vglGetGxmTexture(GL_TEXTURE_2D);
+    t->w = w;
+    t->h = h;
+    if (!t->gxm || sceGxmTextureSetData(t->gxm, t->ptr) < 0 || sceGxmTextureSetWidth(t->gxm, w) < 0 ||
+        sceGxmTextureSetHeight(t->gxm, h) < 0) {
+        FreeOwn(t);
+        return 0;
+    }
+    memset(t->ptr, 0, size);
+    return 1;
+}
+
+void GlGpu::FreeOwn(InPlace *t)
+{
+    if (t->tex)
+        glDeleteTextures(1, &t->tex);   /* vitaGL frees its placeholder */
+    if (t->block)
+        vglLazyFree(t->block);          /* once the GPU is done with it */
+    *t = InPlace{};
+}
+
+/* A descriptor vitaGL rewrote (nothing should make it) points the GPU at its placeholder again:
+ * pointed back at the texels, logged and counted */
+void GlGpu::OwnFix(InPlace *t, const char *what)
+{
+    if (!t->gxm || (sceGxmTextureGetData(t->gxm) == t->ptr && (int)sceGxmTextureGetWidth(t->gxm) == t->w &&
+                    (int)sceGxmTextureGetHeight(t->gxm) == t->h))
+        return;
+    if (m_warnedOwn < 8) {
+        m_warnedOwn++;
+        fprintf(stderr, "[gl] %s's descriptor changed (texels %p, %ux%u): pointed back at %p\n", what,
+                sceGxmTextureGetData(t->gxm), sceGxmTextureGetWidth(t->gxm),
+                sceGxmTextureGetHeight(t->gxm), (void *)t->ptr);
+    }
+    sceGxmTextureSetData(t->gxm, t->ptr);
+    sceGxmTextureSetWidth(t->gxm, t->w);
+    sceGxmTextureSetHeight(t->gxm, t->h);
+    m_st.own_fixed++;
+}
+
+void GlGpu::OwnCheck()
