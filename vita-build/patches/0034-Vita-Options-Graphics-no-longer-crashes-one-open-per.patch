+++ b/game/src/shellutils.cpp
@@ -193,6 +193,14 @@ void DownloadBMP16x2(char *pData) {
 	char *in;
 	char *out;
 
+	/* t29: no image (FrontLoader_TakeFile found none: Options > Graphics asked again for the
+	   options.bmp the Options screen had already taken out of the set, which was still loaded,
+	   so nothing loaded it again; retail read through 0 here and crashed): the last one stays */
+	if (!pData) {
+		printf("[front] DownloadBMP16x2: no image (already taken from the loader), the screen keeps the last\n");
+		return;
+	}
+
