+/* t29: the newest keep of PC_VITA_DIR/logs/thps_*.log kept (the names sort by time) */
+static void PruneLogs(int keep) {
+    char names[64][64];
+    int n = 0;
+    SceUID d = sceIoDopen(PC_VITA_DIR "/logs");
