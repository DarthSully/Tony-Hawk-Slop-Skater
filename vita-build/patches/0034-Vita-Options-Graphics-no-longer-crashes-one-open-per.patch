 platform/pc/README.md            |  6 ++-
 platform/pc/include/pc/file_io.h |  1 +
 platform/pc/include/pc/gl_gpu.h  |  7 +++-
 platform/pc/src/pc_fileio.cpp    | 62 ++++++++++++++++++++++++++--
 platform/pc/src/pc_gpu_gl.cpp    | 70 ++++++++++++++++++++++++++++----
 platform/pc/src/pc_video.cpp     |  2 +-
 platform/pc/src/pc_vita.cpp      | 67 ++++++++++++++++++++++--------
 8 files changed, 192 insertions(+), 31 deletions(-)

