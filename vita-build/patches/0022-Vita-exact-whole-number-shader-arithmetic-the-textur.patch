-    void LayerDraw(int first, int count, int cls, uint16_t hd);
+    /* depth 0: nothing after it in the layer tests depth (no depth pass); why: PC_GL_SPLIT_* */
+    void LayerDraw(int first, int count, int cls, uint16_t hd, int depth = 1, int why = 0);
