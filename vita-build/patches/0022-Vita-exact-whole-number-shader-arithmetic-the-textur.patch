     "uniform vec4 u_target;\n"    /* the VRAM area drawn on: x, y, w, h */
     "uniform float u_atlasCols;\n"    /* the texture cache's atlas: slots a row (16 or 8) */
     /* n bits of v from bit lo (v a whole number below 2^24) */
-    "float bits(float v, float lo, float n) { return mod(floor(v / exp2(lo)), exp2(n)); }\n"
+    /* (the Vita GPU's exp2 is a hair off a power of two, exp2(7.0) just over 128, and its
+     * divisions round: each step rounds to a whole number. Without it a cached slot 127 came out
+     * 126.98, its texels drawn 6 to the left, and slot 0 wasn't cached at all: t12-t14) */
+    "float bits(float v, float lo, float n) {\n"
+    "    float p = floor(exp2(lo) + 0.5), m = floor(exp2(n) + 0.5), q = floor((v + 0.5) / p);\n"
+    "    return q - m * floor((q + 0.5) / m);\n"
+    "}\n"
     /* clip z for view depth w: a projective depth from the near plane to PC_GLES_FAR, its view
      * z measured (1 - e) nearer. Linear in w, so clipping and interpolation are exact (e as well:
      * z (A - C / (z (1 - e))) = A z - C / (1 - e)) */
