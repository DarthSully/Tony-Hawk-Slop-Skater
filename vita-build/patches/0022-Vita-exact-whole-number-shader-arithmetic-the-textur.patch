-    "                  cached > 0.5 ? mod(slot, u_atlasCols) * 256.0 : bits(a_tex.x, 0.0, 6.0) * 16.0,\n"
-    "                  cached > 0.5 ? floor(slot / u_atlasCols) * 256.0 : bits(a_tex.x, 6.0, 9.0));\n"
+    "                  cached > 0.5 ? (slot - u_atlasCols * floor((slot + 0.5) / u_atlasCols)) * 256.0 : bits(a_tex.x, 0.0, 6.0) * 16.0,\n"
