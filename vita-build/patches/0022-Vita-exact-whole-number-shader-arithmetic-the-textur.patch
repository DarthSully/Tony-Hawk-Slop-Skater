+uint64_t Fnv(const char *s, uint64_t h)
+{
+    for (; *s; s++)
+        h = (h ^ (uint8_t)*s) * 0x100000001b3ull;
+    return h;
+}
+
+/* the names src declares with kw ("uniform", "attribute") at a line's start, after the n in names */
+int SourceNames(const char *src, const char *kw, char names[][32], int n)
+{
+    size_t kl = strlen(kw);
+    for (const char *p = strstr(src, kw); p && n < kProgNames; p = strstr(p + kl, kw)) {
+        if (p > src && p[-1] != '\n')
+            continue;
+        const char *q = p + kl;
+        while (*q == ' ')
+            q++;
+        while (*q && *q != ' ')
+            q++;   /* the type */
+        while (*q == ' ')
+            q++;
+        int k = 0;
+        while (k < 31 && (isalnum((unsigned char)*q) || *q == '_'))
+            names[n][k++] = *q++;
+        names[n][k] = 0;
+        if (k)
+            n++;
+    }
+    return n;
+}
+
+/* where program p has the names its sources declare: uniforms (vs, fs), then attributes */
+int ProgramLocs(GLuint p, const char *vs, const char *fs, int32_t *locs)
+{
+    char names[kProgNames][32];
+    int nu = SourceNames(fs, "uniform", names, SourceNames(vs, "uniform", names, 0));
+    int n = SourceNames(vs, "attribute", names, nu);
+    for (int i = 0; i < n; i++)
+        locs[i] = i < nu ? glGetUniformLocation(p, names[i]) : glGetAttribLocation(p, names[i]);
+    return n;
+}
+
+GLuint ProgramLoad(const char *path, const char *vs, const char *fs)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f)
+        return 0;
+    ProgHeader h;
+    int32_t locs[kProgNames], now[kProgNames];
+    void *data = nullptr;
+    GLuint p = 0;
+    if (fread(&h, sizeof h, 1, f) == 1 && !memcmp(h.magic, "THPSPRG1", 8) && h.n <= kProgNames &&
+        fread(locs, 4, h.n, f) == h.n && h.len && h.len < (8u << 20) &&
+        (data = malloc(h.len)) && fread(data, 1, h.len, f) == h.len) {
+        p = glCreateProgram();
+        glProgramBinary(p, (GLenum)h.format, data, (GLsizei)h.len);
+        GLint ok = 0;
+        glGetProgramiv(p, GL_LINK_STATUS, &ok);
