+/* t25: a page's rows decoded by up to 3 threads on cores 1-3 and the game thread at once
+ * (THPS_GL_DECODE_THREADS=n, default 3, 0 = the game thread alone). Each takes a band of rows
+ * (a multiple of 8, so that each writes its own rows of m_slotTransp); the game thread waits for
+ * all before the page is drawn. */
+namespace {
+struct DecodeWorker {
+    SceUID start = -1;
+    GlGpu *gpu = nullptr;
+    int s = 0, y0 = 0, y1 = 0;
+};
+DecodeWorker s_dw[3];
+SceUID s_dwDone = -1;
+int s_dwN = -1;
+
+int DecodeThread(SceSize, void *arg)
+{
+    DecodeWorker *w = *(DecodeWorker **)arg;
+    for (;;) {
+        if (sceKernelWaitSema(w->start, 1, NULL) < 0)
+            return 0;
+        w->gpu->DecodeBand(w->s, w->y0, w->y1);
+        sceKernelSignalSema(s_dwDone, 1);
+    }
+}
+
+void DecodeThreadsStart()
+{
+    const char *e = getenv("THPS_GL_DECODE_THREADS");
+    int want = e ? atoi(e) : 3;
+    s_dwN = 0;
+    if (want <= 0) {
+        fprintf(stderr, "[gl] texture decode threads: off (THPS_GL_DECODE_THREADS=0)\n");
+        return;
+    }
+    if (want > 3)
+        want = 3;
+    s_dwDone = sceKernelCreateSema("thps-dec-done", 0, 0, 3, NULL);
+    static const int masks[3] = { 0x20000, 0x40000, 0x80000 };   /* cores 1, 2, 3 */
+    char cores[16] = "";
+    for (int i = 0; i < want && s_dwDone >= 0; i++) {
+        DecodeWorker *w = &s_dw[i];
+        w->start = sceKernelCreateSema("thps-dec", 0, 0, 1, NULL);
+        SceUID th = sceKernelCreateThread("thps-decode", DecodeThread, 0x10000100 - 12, 0x2000, 0,
+                                          masks[i], NULL);
+        if (th < 0)   /* (core 3 without CapUnlocker) */
+            th = sceKernelCreateThread("thps-decode", DecodeThread, 0x10000100 - 12, 0x2000, 0,
+                                       0x20000 | 0x40000, NULL);
+        if (w->start < 0 || th < 0)
+            break;
+        sceKernelStartThread(th, sizeof w, &w);
+        snprintf(cores + strlen(cores), sizeof cores - strlen(cores), "%s%d", i ? "," : "", i + 1);
+        s_dwN++;
+    }
+    fprintf(stderr, "[gl] texture decode threads: %d (cores %s; THPS_GL_DECODE_THREADS=0 turns them "
+                    "off)\n", s_dwN, s_dwN ? cores : "-");
+}
+} // namespace
