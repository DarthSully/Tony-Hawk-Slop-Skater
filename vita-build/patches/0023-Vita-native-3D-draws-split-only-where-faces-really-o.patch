@@ -346,9 +360,15 @@ class GlGpu {
     std::vector<uint32_t> m_decode;
     std::vector<uint32_t> m_windows;   /* the texture windows seen (the stats line counts them) */
     GlVert m_layerConv[MAX_VERTS];   /* a layer's vertices with their slots (LayerBegin's are const) */
+    /* the layer's textured triangles without a slot before each of its triangles (LayerBegin) */
+    uint32_t m_slowBefore[MAX_VERTS / 3 + 1] = {};
+    /* counts slots freed (CacheInvalidate, CacheCheck): after one, a layer given its slots at
