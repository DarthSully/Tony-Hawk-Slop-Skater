     UseDraw(slow_tris == 0);
     if (slow_tris == 0 && m_drawProgFast) {
         m_st.fast_batches++;
@@ -2358,22 +2404,21 @@ void GlGpu::LayerDraw(int first, int count, int cls, uint16_t hd, int depth, int
         m_st.slow_tris += count / 3;
