     };
 
     /* targets */
@@ -301,6 +305,16 @@ class GlGpu {
     /* ES 2 has no vertex array objects: a draw program's attributes from a client-side array
      * (vitaGL copies those into its frame's memory) */
     void DrawAttribs(const GlVert *v);
+    /* the draw program's attributes from buffer buf (0: client memory at v) */
