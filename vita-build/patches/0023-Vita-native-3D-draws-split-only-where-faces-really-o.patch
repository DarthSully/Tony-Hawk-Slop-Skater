-int GlGpu::CacheVerts(GlVert *v, int n)
+int GlGpu::CacheVerts(GlVert *v, int n, uint32_t *before)
 {
     int slow = 0;
     for (int i = 0; i + 2 < n; i += 3) {
+        if (before)
+            before[i / 3] = (uint32_t)slow;
         if (v[i].clut & 0x8000)
             continue;
         uint64_t key = SlotKey(v[i]);
@@ -3212,6 +3270,8 @@ int GlGpu::CacheVerts(GlVert *v, int n)
         uint16_t w = (uint16_t)(0x8000 | s);
         v[i].clut = v[i + 1].clut = v[i + 2].clut = w;
     }
+    if (before)
+        before[n / 3] = (uint32_t)slow;
     return slow;
 }
 
@@ -3234,6 +3294,7 @@ void GlGpu::CacheInvalidate(int x, int y, int w, int h)
         if (!hit)
             continue;
         m_st.cache_inval++;
+        m_cacheGen++;
         c.key = 0;
     }
     m_lastSlot = -1;
@@ -3265,6 +3326,7 @@ void GlGpu::CacheCheck()
                     m_slot[s].cy, y);
         }
         m_st.cache_stale++;
+        m_cacheGen++;
         m_slot[s].key = 0;
