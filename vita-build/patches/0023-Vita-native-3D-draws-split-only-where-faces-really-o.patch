     }
diff --git a/platform/pc/src/pc_render3d.cpp b/platform/pc/src/pc_render3d.cpp
index 67166a3..3d6bae9 100644
--- a/platform/pc/src/pc_render3d.cpp
+++ b/platform/pc/src/pc_render3d.cpp
@@ -1206,30 +1206,123 @@ bool Renderer3D::ShadowMap(const ShadowSet *s, GlShadow *out)
 /* ---------------------------------------------------------------------------------------------
  * Drawing, while PC_DrawOT walks the ordering table */
 
-/* The 16x16 cells of DrawUpto's grid a face covers on screen (x0, y0, x1, y1, inclusive): all of
- * them for a face that reaches the near plane or isn't in view space */
-void Renderer3D::FaceCells(const Batch *b, const Face *f, int c[4]) const
+namespace {
+
+/* a screen position's cell column (row: limit 31) */
+int GridCell(float p, int limit)
+{
+    return p < 0 ? 0 : p >= (float)(limit * 16 + 15) ? limit : (int)(p / 16);
+}
+
+} // namespace
+
+/* cells x0..x1, y0..y1 (inclusive) at depths lo..hi, into m_span */
+void Renderer3D::SpanBox(int x0, int y0, int x1, int y1, float lo, float hi)
 {
+    for (int cy = y0; cy <= y1; cy++)
+        for (int cx = x0; cx <= x1; cx++)
+            m_span[m_nspan++] = CellZ{ (uint16_t)(cy * 64 + cx), lo, hi };
+}
+
+/* The cells of DrawUpto's grid a face covers on screen and its depth range in each (m_span): per
+ * triangle, the cells its outline reaches (a cell, widened by a pixel, against the triangle's
+ * edges), at the depths its plane has over the part of the cell inside the triangle's box (1/z is
+ * linear on the screen, so the box's corners bound it), within the triangle's corners' range. A
+ * face that reaches the near plane or isn't in view space has every cell at its whole range; one
+ * in a single cell, or with THPS_R3D_EXACT=0, its box at its whole range. */
+void Renderer3D::FaceSpans(const Batch *b, const Face *f)
+{
+    static constexpr int kMaxNv = 24;
     const GlVert *v = &b->sv[f->first];
-    float x0 = 1e30f, y0 = 1e30f, x1 = -1e30f, y1 = -1e30f, near = b->hither > 1 ? b->hither : 1;
-    c[0] = c[1] = 0;
-    c[2] = 63;
-    c[3] = 31;
-    if (!f->nv)
+    float near = b->hither > 1 ? b->hither : 1;
+    float sx[kMaxNv], sy[kMaxNv], x0 = 1e30f, y0 = 1e30f, x1 = -1e30f, y1 = -1e30f;
+    m_nspan = 0;
+    if (!f->nv || f->nv > kMaxNv) {
+        SpanBox(0, 0, 63, 31, f->zmin, f->zmax);
         return;
+    }
     for (int k = 0; k < f->nv; k++) {
-        if (!(v[k].info & PC_GL_I_VIEW) || v[k].z < near)
+        if (!(v[k].info & PC_GL_I_VIEW) || v[k].z < near) {
+            SpanBox(0, 0, 63, 31, f->zmin, f->zmax);
             return;
-        float r = b->h / v[k].z, x = b->ofx + v[k].x * r, y = b->ofy + v[k].y * r;
-        x0 = fminf(x0, x);
-        y0 = fminf(y0, y);
-        x1 = fmaxf(x1, x);
-        y1 = fmaxf(y1, y);
+        }
+        float r = b->h / v[k].z;
+        sx[k] = b->ofx + v[k].x * r;
+        sy[k] = b->ofy + v[k].y * r;
+        x0 = fminf(x0, sx[k]);
+        y0 = fminf(y0, sy[k]);
+        x1 = fmaxf(x1, sx[k]);
+        y1 = fmaxf(y1, sy[k]);
+    }
+    int c0 = GridCell(x0, 63), c1 = GridCell(y0, 31), c2 = GridCell(x1, 63), c3 = GridCell(y1, 31);
+    if (!m_exact || f->nv % 3 || (c0 == c2 && c1 == c3)) {
+        SpanBox(c0, c1, c2, c3, f->zmin, f->zmax);
+        return;
+    }
+    for (int t = 0; t + 2 < f->nv; t += 3) {
+        const float px[3] = { sx[t], sx[t + 1], sx[t + 2] }, py[3] = { sy[t], sy[t + 1], sy[t + 2] };
+        const float w[3] = { 1 / v[t].z, 1 / v[t + 1].z, 1 / v[t + 2].z };
+        float zlo = fminf(v[t].z, fminf(v[t + 1].z, v[t + 2].z));
+        float zhi = fmaxf(v[t].z, fmaxf(v[t + 1].z, v[t + 2].z));
+        float bx0 = fminf(px[0], fminf(px[1], px[2])), bx1 = fmaxf(px[0], fmaxf(px[1], px[2]));
