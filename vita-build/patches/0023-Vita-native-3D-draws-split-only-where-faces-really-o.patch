 #else
     glBindVertexArray(l.vao);
 #endif
@@ -2993,7 +3038,8 @@ void GlGpu::Present(void *sdl_window, int x, int y, int w, int h, int enabled,
                         "store %d cells written in place, %d new copies, %d waits for the GPU; "
