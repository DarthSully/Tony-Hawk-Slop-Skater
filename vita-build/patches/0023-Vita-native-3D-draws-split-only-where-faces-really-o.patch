     }
@@ -3014,22 +3060,32 @@ void GlGpu::Present(void *sdl_window, int x, int y, int w, int h, int enabled,
 
 void GlGpu::DrawAttribs(const GlVert *v)
 {
-    const char *b = (const char *)v;
-    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    DrawAttribsFrom(0, v);
+}
+
+void GlGpu::DrawAttribsFrom(GLuint buf, const GlVert *v)
+{
+    /* in a buffer, the attributes are offsets into it */
+    uintptr_t b = buf ? 0 : (uintptr_t)v;
+    m_attrBuf = buf;
+    glBindBuffer(GL_ARRAY_BUFFER, buf);
     for (GLuint i = 0; i < 6; i++)
         glEnableVertexAttribArray(i);
-    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, sizeof(GVert), b + offsetof(GVert, x));
-    glVertexAttribPointer(1, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof(GVert), b + offsetof(GVert, r));
-    glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, sizeof(GVert), b + offsetof(GVert, u));
+    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, sizeof(GVert), (const void *)(b + offsetof(GVert, x)));
+    glVertexAttribPointer(1, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof(GVert), (const void *)(b + offsetof(GVert, r)));
+    glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, sizeof(GVert), (const void *)(b + offsetof(GVert, u)));
     /* the words as whole-number floats, which the shader unpacks */
-    glVertexAttribPointer(3, 2, GL_UNSIGNED_SHORT, GL_FALSE, sizeof(GVert), b + offsetof(GVert, clut));
-    glVertexAttribPointer(4, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof(GVert), b + offsetof(GVert, tw));
-    glVertexAttribPointer(5, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof(GVert), b + offsetof(GVert, uvr));
+    glVertexAttribPointer(3, 2, GL_UNSIGNED_SHORT, GL_FALSE, sizeof(GVert), (const void *)(b + offsetof(GVert, clut)));
+    glVertexAttribPointer(4, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof(GVert), (const void *)(b + offsetof(GVert, tw)));
+    glVertexAttribPointer(5, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof(GVert), (const void *)(b + offsetof(GVert, uvr)));
+    /* each attribute keeps the buffer it was given */
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
 }
 
 /* positions (attribute 0) and, with uv, texture coordinates (attribute 2) after them */
 void GlGpu::QuadAttribs(const float *v, int stride_floats, int uv)
 {
+    m_attrBuf = 0;
     glBindBuffer(GL_ARRAY_BUFFER, 0);
     for (GLuint i = 1; i < 6; i++)
         glDisableVertexAttribArray(i);
@@ -3187,10 +3243,12 @@ void GlGpu::CacheDecode(int s)
 
 /* each textured triangle's page to its slot (GlVert.clut = 0x8000 | slot); the number of textured
