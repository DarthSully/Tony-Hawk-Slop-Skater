diff --git a/platform/pc/src/pc_vita.cpp b/platform/pc/src/pc_vita.cpp
new file mode 100644
index 0000000..909961a
--- /dev/null
+++ b/platform/pc/src/pc_vita.cpp
@@ -0,0 +1,110 @@
+/* What only the PS Vita build has (THPS_ARCH=vita; see platform/pc/README.md, "PS Vita"): the
+ * process's stack and heap sizes, the log file, the settings file standing in for the
+ * environment, and the R3000's division results. */
+#ifdef __vita__
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <psp2/io/fcntl.h>
+#include <psp2/io/stat.h>
+#include <psp2/kernel/clib.h>
+
+#include "pc/platform.h"
+#include "pc_runtime.h"
+
+/* The game thread is the main thread: the PS1 code's stack frames are large, and the default
+ * is 256 KB. newlib's heap holds the game's 8 MB block and the runtime's buffers (decoded sound
+ * banks, the texture store, the extracted files' index); vitaGL keeps its own pools. */
+extern "C" {
+int sceUserMainThreadStackSize = 4 * 1024 * 1024;
+int _newlib_heap_size_user = 192 * 1024 * 1024;
+}
+
+namespace {
+
+SceUID g_logFd = -1;
+
+/* stderr's writes: straight to the file and synced, so a crash that takes the console down
+ * loses nothing written before it (stdio's buffers and the kernel's cache would) */
+int LogWrite(void *cookie, const char *buf, int n) {
+    (void)cookie;
+    if (g_logFd >= 0 && n > 0) {
+        sceIoWrite(g_logFd, buf, (SceSize)n);
+        sceIoSyncByFd(g_logFd, 0);
+    }
+    sceClibPrintf("%.*s", n, buf);   /* and to a debugger's console (vitacompanion, psp2shell) */
+    return n;
+}
+
+/* PC_VITA_DIR/env.txt: NAME=value lines, as the environment variables the PC build reads
+ * (THPS_TRACE=1, THPS_SCALE=1 ...); '#' starts a comment */
+void LoadEnv() {
+    char line[512];
+    FILE *f = fopen(PC_VITA_DIR "/env.txt", "r");
+    if (!f)
+        return;
+    while (fgets(line, sizeof line, f)) {
+        char *eq, *end = line + strlen(line);
+        while (end > line && (end[-1] == '\n' || end[-1] == '\r' || end[-1] == ' '))
+            *--end = 0;
+        if (line[0] == '#' || !(eq = strchr(line, '=')))
+            continue;
+        *eq = 0;
+        setenv(line, eq + 1, 1);
+    }
+    fclose(f);
+}
+
+} // namespace
+
+/* Before the first log line (Runtime::Main): the data folder, the settings, stderr to
+ * PC_VITA_DIR/thps.log (stdout too: the game's debug output, THPS_TRACE). */
+void PC_VitaLogOpen(void) {
+    FILE *f;
+    sceIoMkdir("ux0:data", 0777);
+    sceIoMkdir(PC_VITA_DIR, 0777);
+    LoadEnv();
+    g_logFd = sceIoOpen(PC_VITA_DIR "/thps.log", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0666);
+    f = funopen(NULL, NULL, LogWrite, NULL, NULL);
+    if (f) {
+        setvbuf(f, NULL, _IOLBF, 1024);
+        stderr = f;
+        stdout = f;
+    }
+}
+
+/* ---- the R3000's division --------------------------------------------------------------------
+ * The Cortex-A9 has no divide instruction: GCC calls the EABI helpers, and link.py wraps them
+ * (VITA_WRAP) so that a zero divisor gives what MIPS `div`/`divu` leave in LO and HI, as the
+ * x86 builds' FixDivide does from their fault handler: quotient (dividend < 0 ? 1 : -1) or all
+ * ones unsigned, remainder the dividend. libgcc's own answer would be 0. INT_MIN / -1 is
+ * INT_MIN, remainder 0, on both. The idivmod pair comes back in r0 (quotient) and r1
+ * (remainder): a 64-bit return. */
+extern "C" {
+int __real___aeabi_idiv(int, int);
+unsigned __real___aeabi_uidiv(unsigned, unsigned);
+uint64_t __real___aeabi_idivmod(int, int);
+uint64_t __real___aeabi_uidivmod(unsigned, unsigned);
+
+int __wrap___aeabi_idiv(int n, int d) { return d ? __real___aeabi_idiv(n, d) : n < 0 ? 1 : -1; }
+
+unsigned __wrap___aeabi_uidiv(unsigned n, unsigned d) {
+    return d ? __real___aeabi_uidiv(n, d) : 0xffffffffu;
+}
+
+uint64_t __wrap___aeabi_idivmod(int n, int d) {
+    if (!d)
+        return (uint64_t)(uint32_t)(n < 0 ? 1 : -1) | (uint64_t)(uint32_t)n << 32;
+    return __real___aeabi_idivmod(n, d);
+}
+
+uint64_t __wrap___aeabi_uidivmod(unsigned n, unsigned d) {
+    if (!d)
+        return 0xffffffffull | (uint64_t)n << 32;
+    return __real___aeabi_uidivmod(n, d);
+}
+} // extern "C"
+
+#endif /* __vita__ */
