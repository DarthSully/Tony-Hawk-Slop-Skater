+
+/* t22: the framebuffer and viewport as last set, so that a draw rebinding the target it is already
+ * on costs nothing (every draw used to: vitaGL may start a new scene for each bind, loading and
+ * storing the whole target, which grows with the resolution). Forgotten at each swap. */
+static GLuint s_fb = ~0u;
+static GLint s_vp[4] = { -1, -1, -1, -1 };
+static int s_fbBinds, s_fbSkip = -1;
+
+static void BindFb(GLenum target, GLuint f)
+{
+    if (s_fbSkip < 0) {
+        const char *e = getenv("THPS_GL_FBCACHE");
+        s_fbSkip = !(e && e[0] == '0');
+    }
+    if (target == GL_FRAMEBUFFER && s_fbSkip && f == s_fb)
+        return;
+    glBindFramebuffer(target, f);
+    s_fb = target == GL_FRAMEBUFFER ? f : ~0u;
+    s_vp[0] = -1;
+    s_fbBinds++;
+}
+
+static void SetViewport(GLint x, GLint y, GLsizei w, GLsizei h)
+{
+    if (s_fbSkip > 0 && s_vp[0] == x && s_vp[1] == y && s_vp[2] == w && s_vp[3] == h)
+        return;
+    glViewport(x, y, w, h);
+    s_vp[0] = x;
+    s_vp[1] = y;
+    s_vp[2] = w;
+    s_vp[3] = h;
+}
+
+static void ForgetFb()
+{
+    s_fb = ~0u;
+    s_vp[0] = -1;
+}
+
