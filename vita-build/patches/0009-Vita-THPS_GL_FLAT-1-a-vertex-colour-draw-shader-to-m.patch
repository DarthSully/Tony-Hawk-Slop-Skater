From d5a53870a0390c1d97bc9351e86a4b30a2deb2be Mon Sep 17 00:00:00 2001
From: vita-build <vita@build>
Date: Sat, 24 Oct 2026 12:20:46 +0300
Subject: [PATCH] Vita: THPS_GL_FLAT=1, a vertex-colour draw shader to measure
 the texture emulation's GPU cost

---
 platform/pc/include/pc/gl_shaders_gles.h | 20 ++++++++++++++++++++
 platform/pc/src/pc_gpu_gl.cpp            | 10 ++++++++++
 2 files changed, 30 insertions(+)

diff --git a/platform/pc/include/pc/gl_shaders_gles.h b/platform/pc/include/pc/gl_shaders_gles.h
index 1fed83c..5595163 100644
--- a/platform/pc/include/pc/gl_shaders_gles.h
+++ b/platform/pc/include/pc/gl_shaders_gles.h
@@ -91,6 +91,26 @@ static const char *gl_draw_vs =
     "    v_uvr = a_uvr;\n"
     "}\n";
 
+/* THPS_GL_FLAT=1 (a measurement): the vertex colour only, no texture lookups and no discard. The
+ * blended pass (u_pass 2, reverse-subtract) adds nothing. Every varying is read, so the program's
+ * interface stays the one gl_draw_vs writes. */
+static const char *gl_draw_flat_fs =
+    "#ifdef GL_ES\n"
+    "precision highp float;\n"
+    "#endif\n"
+    "varying vec3 v_color;\n"
+    "varying vec2 v_uv;\n"
+    "varying vec4 v_page;\n"
+    "varying vec4 v_mode;\n"
+    "varying vec4 v_flags;\n"
+    "varying vec4 v_twin;\n"
+    "varying vec4 v_uvr;\n"
+    "uniform float u_pass;\n"
+    "void main() {\n"
+    "    float z = 0.0 * (v_uv.x + v_page.x + v_mode.x + v_flags.x + v_twin.x + v_uvr.x);\n"
+    "    gl_FragColor = vec4((v_color + z) * (u_pass > 1.5 ? 0.0 : 1.0), 1.0);\n"
+    "}\n";
+
 /* gl_FragColor: the colour, alpha = 1 - the weight the old pixel keeps (see above). B-F is drawn
  * in a separate pass with a reverse-subtract equation: u_pass 1 draws only the opaque pixels, 2
  * only the blended ones. */
diff --git a/platform/pc/src/pc_gpu_gl.cpp b/platform/pc/src/pc_gpu_gl.cpp
index 2a94c9a..8c04916 100644
--- a/platform/pc/src/pc_gpu_gl.cpp
+++ b/platform/pc/src/pc_gpu_gl.cpp
@@ -553,7 +553,17 @@ int GlGpu::Init(int fixed_scale, int out_w, int out_h)
     m_outH = out_h > 0 ? out_h : 480;
     m_nsurf = 0;
 
+#ifdef PC_GLES
+    const char *draw_fs = gl_draw_fs;
+    const char *flat = getenv("THPS_GL_FLAT");
+    if (flat && atoi(flat) > 0) {
+        draw_fs = gl_draw_flat_fs;
+        fprintf(stderr, "[gl] THPS_GL_FLAT: vertex colours only (a measurement)\n");
+    }
+    m_drawProg = Program(gl_draw_vs, draw_fs);
+#else
     m_drawProg = Program(gl_draw_vs, gl_draw_fs);
+#endif
     m_copyProg = Program(gl_copy_vs, gl_copy_fs);
     m_presentProg = Program(gl_present_vs, gl_present_fs);
     fprintf(stderr, "[gl] shaders: draw %s, copy %s, present %s\n", m_drawProg ? "ok" : "FAILED",
-- 
2.53.0

