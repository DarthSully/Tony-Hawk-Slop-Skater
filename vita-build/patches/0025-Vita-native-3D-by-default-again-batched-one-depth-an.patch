+void GlGpu::LayerBatch(int first, int count, int cls, int why)
+{
+#ifndef PC_GLES
+    /* desktop GL: the draws as before, one class at a time is not what this is for */
+    (void)first, (void)count, (void)cls, (void)why;
+#else
+#ifdef __vita__
+    PC_VITA_PROF_SCOPE(PC_PROF_DRAW);
+#endif
+    Layer &l = m_layer;
+    if (!l.active || count <= 0)
+        return;
+    m_st.layer_draws++;
+    m_st.layer_batches++;
+    if (why >= 0 && why < PC_GL_SPLITS)
+        m_st.split[why]++;
+    Flush();
+    Prepare();
+    int slow_tris = 1;
+    GLuint buf = l.buf;
+    if (m_cacheOn && l.verts == m_layerConv) {
+        if (l.conv_gen == m_cacheGen && first % 3 == 0 && count % 3 == 0) {
+            slow_tris = (int)(m_slowBefore[(first + count) / 3] - m_slowBefore[first / 3]);
+        } else {
+            memcpy(m_layerConv + first, l.src + first, (size_t)count * sizeof(GVert));
+            slow_tris = CacheVerts(m_layerConv + first, count);
+            buf = 0;
+        }
+    }
+    if (!buf)
+        m_st.layer_client++;
+    float proj[4] = { (float)l.lp.ofs_x + l.lp.ofx, (float)l.lp.ofs_y + l.lp.ofy, l.lp.h,
+                      l.lp.hither };
+    if (!m_projSet || memcmp(proj, m_proj, sizeof proj)) {
+        memcpy(m_proj, proj, sizeof proj);
+        m_projSet = 1;
+        m_projApplied[0] = m_projApplied[1] = 0;
+    }
+    UseDraw(slow_tris == 0);
+    if (slow_tris == 0 && m_drawProgFast) {
+        m_st.fast_batches++;
+        m_st.fast_tris += count / 3;
+    } else {
+        m_st.slow_batches++;
+        m_st.slow_tris += count / 3;
+        m_st.uncached_tris += m_cacheOn ? slow_tris : 0;
+    }
+    BindStore();
+    if (!buf)
+        DrawAttribs(l.verts);
+    else if (m_attrBuf != buf)
+        DrawAttribsFrom(buf, nullptr);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LEQUAL);
+    Target *ts[MAX_SURFACES + 1];
+    int nt = LayerTargets(ts);
+    for (int i = 0; i < nt; i++) {
+        ts[i]->Use();
+        if (!ts[i]->Scissor(l.clip[0], l.clip[1], l.clip[2], l.clip[3], l.wide))
+            continue;
+        DrawUniforms(ts[i]);
+        int n = 0;
+        if (cls & 1) {
+            /* the opaque faces' true depth (texels the shader discards write none), then their
+             * colour where it is within the tolerance of the nearest: a decal over its floor
+             * passes, and the later of the two (the PS1's order) is the one left */
+            SetBlend(0);
+            DPass(1, 1);
+            glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+            glDepthMask(GL_TRUE);
+            glDrawArrays(GL_TRIANGLES, first, count);
+            glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+            glDepthMask(GL_FALSE);
+            DPass(0, 1);
+            glDrawArrays(GL_TRIANGLES, first, count);
+            n += 2;
+        }
+        glDepthMask(GL_FALSE);
+        if (cls & 2) {
+            /* semi-transparent faces after every opaque one, in their own order */
+            SetBlend(0);
+            DPass(0, 2);
+            glDrawArrays(GL_TRIANGLES, first, count);
+            n++;
+        }
+        if (cls & 4) {
+            /* subtractive (B-F): after the other semi-transparent ones */
+            DPass(0, 3);
+            SetBlend(1);
+            glDrawArrays(GL_TRIANGLES, first, count);
+            SetBlend(2);
+            glDrawArrays(GL_TRIANGLES, first, count);
+            n += 2;
+        }
+        DPass(0);
+        m_st.draws++;
+        m_st.gl_draws += n;
+    }
+    glDisable(GL_DEPTH_TEST);
+    glDepthMask(GL_TRUE);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_BLEND);
+#endif
+}
