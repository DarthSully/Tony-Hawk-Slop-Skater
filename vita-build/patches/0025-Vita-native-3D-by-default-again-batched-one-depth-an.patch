index 0000000..c24b61b
--- /dev/null
+++ b/platform/pc/src/pc_vitagfx.cpp
@@ -0,0 +1,48 @@
+/* The Vita graphics settings (pc_vitagfx.h): defaults and env.txt. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "pc_vitagfx.h"
+
+namespace {
+
+PC_VitaGfx s_gfx;
+bool s_read = false;
+
+void Read()
+{
+    static const int sizes[3][2] = { { 512, 240 }, { 720, 408 }, { 960, 544 } };
+    const char *e;
+    int w, h;
+    s_gfx = PC_VitaGfx{ 960, 544, 1, 1, 60, 1 };
+    if ((e = getenv("THPS_VITA_RES")) && sscanf(e, "%dx%d", &w, &h) == 2) {
+        for (int i = 0; i < 3; i++)
+            if (w == sizes[i][0] && h == sizes[i][1]) {
+                s_gfx.render_w = w;
+                s_gfx.render_h = h;
+            }
+    }
+    if ((e = getenv("THPS_WIDESCREEN")))
+        s_gfx.widescreen = atoi(e) != 0;
+    if ((e = getenv("THPS_FILTER")))
+        s_gfx.smoothing = e[0] != '0';
+    if ((e = getenv("THPS_VITA_FPS")) && atoi(e) == 30)
+        s_gfx.frame_rate = 30;
+    if ((e = getenv("THPS_RENDER3D")))
+        s_gfx.native3d = strcmp(e, "psx") != 0;
+    fprintf(stderr, "[gfx] render %dx%d, widescreen %s, smoothing %s, %d fps, 3D %s\n",
+            s_gfx.render_w, s_gfx.render_h, s_gfx.widescreen ? "on" : "off",
+            s_gfx.smoothing ? "on" : "off", s_gfx.frame_rate, s_gfx.native3d ? "native" : "PS1");
+}
+
+} // namespace
+
+extern "C" const PC_VitaGfx *PC_VitaGfxGet(void)
+{
+    if (!s_read) {
+        s_read = true;
+        Read();
+    }
+    return &s_gfx;
+}
