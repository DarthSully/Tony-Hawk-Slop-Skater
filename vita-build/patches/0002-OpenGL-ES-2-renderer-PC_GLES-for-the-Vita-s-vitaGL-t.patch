diff --git a/platform/pc/include/pc/gl_shaders_gles.h b/platform/pc/include/pc/gl_shaders_gles.h
new file mode 100644
index 0000000..3d9452c
--- /dev/null
+++ b/platform/pc/include/pc/gl_shaders_gles.h
@@ -0,0 +1,231 @@
+/* GLSL ES 1.00 sources for the OpenGL ES 2 build of the GPU backend (PC_GLES: the PS Vita, through
+ * vitaGL's GLSL translator; Linux with THPS_GLES=1 for testing it on a desktop). The same drawing
+ * as gl_shaders.h, within what ES 2 and the Vita's GPU have:
+ *
+ * - The texture store and the CPU's pixels are LUMINANCE_ALPHA textures, not R16UI: a texel's
+ *   low byte in L, its high byte in A. Every texel lookup, CLUT index and texture window is float
+ *   arithmetic on whole numbers (exact in 32-bit floats), with no integer types or bit operators.
+ * - The vertex attributes are floats; the shader unpacks the info and CLUT words (texture page,
+ *   colour depth, blend mode, flags) in the vertex stage, into varyings that are the same at each
+ *   corner (no flat varyings in ES 2: the fragment stage rounds them).
+ * - No dual-source blending: the weight the old pixel keeps goes out in alpha, blended as
+ *   dst * (1 - src.a) + src; alpha itself is never written by drawing (its blend factors keep the
+ *   old value), so the mask bit is kept only for the CPU's pixels (GlGpu::Blit) and fills.
+ * - No gl_FragDepth: depth comes from the vertex stage, as a projective depth of view z (near =
+ *   the layer's near plane, which also clips as gl_ClipDistance did), monotonic like the linear
+ *   z / 2^20 it stands for. The colour pass's tolerance (u_dpass 0) is a relative one (clipZ).
+ * - The screens are drawn at the PS1's resolution (GlGpu::Init: fixed scale 1), so there is no
+ *   texture-coordinate fix (u_uvfix, derivatives) and the geometry moves by half a pixel.
+ * - Neither the Dreamcast's skater shadows nor filtered HD texture gradients (the Dreamcast data's
+ *   extras) are drawn; HD textures are sampled plainly. */
+#ifndef PC_GPU_GL_SHADERS_GLES_H
+#define PC_GPU_GL_SHADERS_GLES_H
+
+/* the far end of the projective depth: far beyond any level (linear depth reached 2^20) */
+#define PC_GLES_FAR "16777216.0"
+
+static const char *gl_draw_vs =
+    "#ifdef GL_ES\n"
+    "precision highp float;\n"
+    "#endif\n"
+    "attribute vec3 a_pos;\n"     /* x, y, w (perspective divisor) or view x, y, z */
+    "attribute vec4 a_color;\n"
+    "attribute vec2 a_uv;\n"
+    "attribute vec2 a_tex;\n"     /* clut word, info bits (see pc_gpu_gl.cpp) */
+    "attribute vec4 a_twin;\n"    /* texture window and_x, and_y, or_x, or_y */
+    "attribute vec4 a_uvr;\n"     /* texels the face spans: u, v min, max */
+    "varying vec3 v_color;\n"
+    "varying vec2 v_uv;\n"
+    "varying vec4 v_page;\n"      /* texture page x, y; CLUT x, y */
+    "varying vec4 v_mode;\n"      /* colour depth, blend mode, textured, raw */
+    "varying vec4 v_flags;\n"     /* semi-transparent, native 3D (view), -, - */
+    "varying vec4 v_twin;\n"
+    "varying vec4 v_uvr;\n"
+    "uniform float u_shift;\n"
+    "uniform float u_dpass;\n"
+    "uniform vec4 u_proj;\n"
+    "uniform vec4 u_target;\n"    /* the VRAM area drawn on: x, y, w, h */
+    /* n bits of v from bit lo (v a whole number below 2^24) */
+    "float bits(float v, float lo, float n) { return mod(floor(v / exp2(lo)), exp2(n)); }\n"
+    /* clip z for view depth w: a projective depth from the near plane to PC_GLES_FAR, its view
+     * z measured (1 - e) nearer. Linear in w, so clipping and interpolation are exact (e as well:
+     * z (A - C / (z (1 - e))) = A z - C / (1 - e)) */
+    "float clipZ(float w, float e) {\n"
+    "    float n = max(u_proj.w, 1.0), f = " PC_GLES_FAR ";\n"
+    "    return (f + n) / (f - n) * w - 2.0 * f * n / ((f - n) * (1.0 - e));\n"
+    "}\n"
+    "void main() {\n"
+    "    float info = a_tex.y;\n"
+    "    vec2 k = 2.0 / u_target.zw;\n"
+    "    bool view = bits(info, 14.0, 1.0) > 0.5, dflag = bits(info, 13.0, 1.0) > 0.5;\n"
+    "    bool sky = bits(info, 15.0, 1.0) > 0.5;\n"
+    "    float w;\n"
+    "    if (view) {\n"
+    "        vec3 v = a_pos;\n"
+    "        vec2 o = (u_proj.xy + u_shift - u_target.xy) * k - 1.0;\n"
+    "        gl_Position = vec4(o * v.z + u_proj.z * k * v.xy, 0.0, v.z);\n"
+    "        w = v.z;\n"
+    "    } else {\n"
+    "        vec2 p = (a_pos.xy + u_shift - u_target.xy) * k - 1.0;\n"
+    "        gl_Position = vec4(p, 0.0, 1.0) * a_pos.z;\n"
+    "        w = a_pos.z;\n"
+    "    }\n"
+    /* gl_shaders.h's gl_FragDepth: sky at the far end; native faces' true depth (u_dpass 1); the
+     * colour pass a little in front (1/256 of the depth: gl_shaders.h's 2 more units would not be
+     * linear); everything else at the near end, always passing. A layer's faces nearer than its
+     * near plane are clipped, as gl_ClipDistance did */
+    "    if (sky) gl_Position.z = gl_Position.w;\n"
+    "    else if (view && u_dpass > 0.5) gl_Position.z = clipZ(w, 0.0);\n"
+    "    else if (view || dflag) gl_Position.z = clipZ(w, 1.0 / 256.0);\n"
+    "    else gl_Position.z = -0.9999 * gl_Position.w;\n"
+    "    v_color = a_color.rgb;\n"
+    "    v_uv = a_uv;\n"
+    "    v_page = vec4(bits(info, 0.0, 4.0) * 64.0, bits(info, 4.0, 1.0) * 256.0,\n"
+    "                  bits(a_tex.x, 0.0, 6.0) * 16.0, bits(a_tex.x, 6.0, 9.0));\n"
+    "    v_mode = vec4(bits(info, 7.0, 2.0), bits(info, 5.0, 2.0), bits(info, 9.0, 1.0),\n"
+    "                  bits(info, 10.0, 1.0));\n"
+    "    v_flags = vec4(bits(info, 11.0, 1.0), view ? 1.0 : 0.0, 0.0, 0.0);\n"
+    "    v_twin = a_twin;\n"
+    "    v_uvr = a_uvr;\n"
+    "}\n";
+
+/* gl_FragColor: the colour, alpha = 1 - the weight the old pixel keeps (see above). B-F is drawn
+ * in a separate pass with a reverse-subtract equation: u_pass 1 draws only the opaque pixels, 2
+ * only the blended ones. */
+static const char *gl_draw_fs =
+    "#ifdef GL_ES\n"
+    "precision highp float;\n"
+    "#endif\n"
+    "varying vec3 v_color;\n"
+    "varying vec2 v_uv;\n"
+    "varying vec4 v_page;\n"
+    "varying vec4 v_mode;\n"
+    "varying vec4 v_flags;\n"
+    "varying vec4 v_twin;\n"
+    "varying vec4 v_uvr;\n"
+    "uniform sampler2D u_vram;\n"
+    "uniform sampler2D u_hd;\n"
+    "uniform float u_pass;\n"
+    /* the texture store's 16-bit texel at x, y (wrapping as VRAM does): its low and high bytes */
+    "vec2 vram(float x, float y) {\n"
+    "    vec4 t = texture2D(u_vram, (vec2(mod(x, 1024.0), mod(y, 512.0)) + 0.5) /\n"
+    "                               vec2(1024.0, 512.0));\n"
+    "    return floor(vec2(t.r, t.a) * 255.0 + 0.5);\n"
+    "}\n"
+    /* (u & a) | o of 8-bit whole numbers: the texture window */
+    "float window(float u, float a, float o) {\n"
+    "    if (a > 254.5 && o < 0.5) return u;\n"
+    "    float r = 0.0, p = 1.0;\n"
+    "    for (int i = 0; i < 8; i++) {\n"
+    "        float ub = mod(floor(u / p), 2.0), ab = mod(floor(a / p), 2.0),\n"
+    "              ob = mod(floor(o / p), 2.0);\n"
+    "        r += p * max(ub * ab, ob);\n"
+    "        p *= 2.0;\n"
+    "    }\n"
+    "    return r;\n"
+    "}\n"
+    "void main() {\n"
+    "    vec4 page = floor(v_page + 0.5), mode = floor(v_mode + 0.5);\n"
+    "    vec4 tw = floor(v_twin + 0.5), uvr = floor(v_uvr + 0.5);\n"
+    "    bool view = v_flags.y > 0.5;\n"
+    "    float depth = mode.x, abr = mode.y;\n"
+    /* texture coordinates at the pixel's corner, rounded to the nearest texel like the PS1 (at
+     * the PS1's resolution the geometry moved by half a pixel instead, gl_shaders.h) */
+    "    vec2 uv = v_uv + 0.5;\n"
+    "    if (view || uvr != vec4(0.0, 0.0, 255.0, 255.0))\n"
+    "        uv = clamp(uv, uvr.xy, uvr.zw + 0.999);\n"
+    "    bool semi = v_flags.x > 0.5;\n"
+    "    vec3 c = v_color;\n"
+    "    bool blend = semi;\n"
+    "    float hd_a = 1.0;\n"
+    "    if (mode.z > 0.5 && depth > 2.5) {\n"
+    "        vec4 t = texture2D(u_hd, v_uv / 256.0);\n"
+    "        if (t.a < 0.03) discard;\n"
+    "        c = mode.w > 0.5 ? t.rgb : min(t.rgb * v_color * (255.0 / 128.0), vec3(1.0));\n"
+    "        hd_a = t.a;\n"
+    "    } else if (mode.z > 0.5) {\n"
+    "        float u = window(mod(floor(uv.x), 256.0), tw.x, tw.z);\n"
+    "        float v = window(mod(floor(uv.y), 256.0), tw.y, tw.w);\n"
+    "        vec2 t;\n"
+    "        if (depth < 0.5) {\n"
+    "            vec2 w = vram(page.x + floor(u / 4.0), page.y + v);\n"
+    "            float q = mod(u, 4.0), b = q < 1.5 ? w.x : w.y;\n"
+    "            float i = mod(q, 2.0) < 0.5 ? mod(b, 16.0) : floor(b / 16.0);\n"
+    "            t = vram(page.z + i, page.w);\n"
+    "        } else if (depth < 1.5) {\n"
+    "            vec2 w = vram(page.x + floor(u / 2.0), page.y + v);\n"
+    "            t = vram(page.z + (mod(u, 2.0) < 0.5 ? w.x : w.y), page.w);\n"
+    "        } else {\n"
+    "            t = vram(page.x + u, page.y + v);\n"
+    "        }\n"
+    "        if (t.x + t.y < 0.5) discard;\n"
+    "        vec3 tc = vec3(mod(t.x, 32.0), floor(t.x / 32.0) + mod(t.y, 4.0) * 8.0,\n"
+    "                       mod(floor(t.y / 4.0), 32.0)) / 31.0;\n"
+    "        c = mode.w > 0.5 ? tc : min(tc * v_color * (255.0 / 128.0), vec3(1.0));\n"
+    "        blend = semi && t.y > 127.5;\n"
+    "    }\n"
+    "    if ((u_pass > 0.5 && u_pass < 1.5 && blend) || (u_pass > 1.5 && !blend)) discard;\n"
+    "    float keep = 0.0;\n"
+    "    if (blend) {\n"
+    "        if (abr < 0.5) { c *= 0.5; keep = 0.5; }\n"
+    "        else if (abr > 2.5) { c *= 0.25; keep = 1.0; }\n"
+    "        else keep = 1.0;\n"
+    "    }\n"
+    "    c *= hd_a;\n"
+    "    keep = hd_a * keep + 1.0 - hd_a;\n"
+    "    gl_FragColor = vec4(c, 1.0 - keep);\n"
+    "}\n";
+
+/* 16-bit pixels the CPU wrote (GlGpu::Blit) into a render target: the same LUMINANCE_ALPHA
+ * texture as the texture store's, their VRAM x, y at its 0, 0. */
+static const char *gl_copy_fs =
+    "#ifdef GL_ES\n"
+    "precision highp float;\n"
+    "#endif\n"
+    "uniform sampler2D u_vram;\n"
+    "uniform vec4 u_map;\n"         /* the target's VRAM x, y; pixels per texel */
+    "uniform vec2 u_src;\n"         /* the pixels' VRAM x, y */
+    "void main() {\n"
+    "    vec2 p = floor(gl_FragCoord.xy / u_map.zw) + u_map.xy - u_src;\n"
+    "    vec4 s = texture2D(u_vram, (p + 0.5) / vec2(1024.0, 512.0));\n"
+    "    vec2 t = floor(vec2(s.r, s.a) * 255.0 + 0.5);\n"
+    "    gl_FragColor = vec4(vec3(mod(t.x, 32.0), floor(t.x / 32.0) + mod(t.y, 4.0) * 8.0,\n"
+    "                             mod(floor(t.y / 4.0), 32.0)) / 31.0, t.y > 127.5 ? 1.0 : 0.0);\n"
+    "}\n";
+
+static const char *gl_copy_vs =
+    "#ifdef GL_ES\n"
+    "precision highp float;\n"
+    "#endif\n"
+    "attribute vec2 a_pos;\n"
+    "uniform vec4 u_target;\n"
+    "void main() {\n"
+    "    gl_Position = vec4((a_pos - u_target.xy) * 2.0 / u_target.zw - 1.0, 0.0, 1.0);\n"
+    "}\n";
+
+/* A texture's area onto the bound framebuffer (the window; a target's pixels onto another). */
+static const char *gl_present_vs =
+    "#ifdef GL_ES\n"
+    "precision highp float;\n"
+    "#endif\n"
+    "attribute vec2 a_pos;\n"
+    "attribute vec2 a_uv;\n"
+    "varying vec2 v_uv;\n"
+    "void main() {\n"
+    "    gl_Position = vec4(a_pos, 0.0, 1.0);\n"
+    "    v_uv = a_uv;\n"
+    "}\n";
+
+static const char *gl_present_fs =
+    "#ifdef GL_ES\n"
+    "precision highp float;\n"
+    "#endif\n"
+    "varying vec2 v_uv;\n"
+    "uniform sampler2D u_tex;\n"
+    "uniform float u_alpha;\n"      /* 1: copy alpha too (a target's pixels), 0: opaque */
+    "void main() {\n"
+    "    vec4 t = texture2D(u_tex, v_uv);\n"
+    "    gl_FragColor = vec4(t.rgb, u_alpha > 0.5 ? t.a : 1.0);\n"
+    "}\n";
+
+#endif
