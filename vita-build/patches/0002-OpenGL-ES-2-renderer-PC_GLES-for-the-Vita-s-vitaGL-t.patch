+#ifdef PC_GLES
+/* ---------------------------------------------------------------------------------------------
+ * OpenGL ES 2 */
+
+void GlGpu::DrawAttribs(const GlVert *v)
+{
+    const char *b = (const char *)v;
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    for (GLuint i = 0; i < 6; i++)
+        glEnableVertexAttribArray(i);
+    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, sizeof(GVert), b + offsetof(GVert, x));
+    glVertexAttribPointer(1, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof(GVert), b + offsetof(GVert, r));
+    glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, sizeof(GVert), b + offsetof(GVert, u));
+    /* the words as whole-number floats, which the shader unpacks */
+    glVertexAttribPointer(3, 2, GL_UNSIGNED_SHORT, GL_FALSE, sizeof(GVert), b + offsetof(GVert, clut));
+    glVertexAttribPointer(4, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof(GVert), b + offsetof(GVert, tw));
+    glVertexAttribPointer(5, 4, GL_UNSIGNED_BYTE, GL_FALSE, sizeof(GVert), b + offsetof(GVert, uvr));
+}
+
+/* positions (attribute 0) and, with uv, texture coordinates (attribute 2) after them */
+void GlGpu::QuadAttribs(const float *v, int stride_floats, int uv)
+{
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    for (GLuint i = 1; i < 6; i++)
+        glDisableVertexAttribArray(i);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, stride_floats * (GLsizei)sizeof(float), v);
+    if (uv) {
+        glEnableVertexAttribArray(2);
+        glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, stride_floats * (GLsizei)sizeof(float),
+                              v + 2);
+    }
+}
+
+void GlGpu::Upload16(int x, int y, int w, int h, const uint16_t *src, int stride)
+{
+    /* little-endian: each pixel's low byte becomes L, its high byte A */
+    m_upload.resize((size_t)w * h * 2);
+    for (int j = 0; j < h; j++)
+        memcpy(&m_upload[(size_t)j * w * 2], src + (size_t)j * stride, (size_t)w * 2);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 2);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, x, y, w, h, GL_LUMINANCE_ALPHA, GL_UNSIGNED_BYTE,
+                    m_upload.data());
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+}
+
+void GlGpu::BlitPixels(const Target *from, int fx0, int fy0, int fx1, int fy1, GLuint to_fbo,
+                       int to_w, int to_h, int tx0, int ty0, int tx1, int ty1)
+{
+    float u0 = (float)fx0 / from->pw, u1 = (float)fx1 / from->pw;
+    float v0 = (float)fy0 / from->ph, v1 = (float)fy1 / from->ph;
+    float x0 = 2.0f * tx0 / to_w - 1, x1 = 2.0f * tx1 / to_w - 1;
+    float y0 = 2.0f * ty0 / to_h - 1, y1 = 2.0f * ty1 / to_h - 1;
+    float q[16] = { x0, y0, u0, v0, x1, y0, u1, v0, x0, y1, u0, v1, x1, y1, u1, v1 };
+    glBindFramebuffer(GL_FRAMEBUFFER, to_fbo);
+    glViewport(0, 0, to_w, to_h);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_BLEND);
+    glDisable(GL_DEPTH_TEST);
+    glUseProgram(m_presentProg);
+    glUniform1f(m_presentUAlpha, 1.0f);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, from->tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    QuadAttribs(q, 4, 1);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+}
